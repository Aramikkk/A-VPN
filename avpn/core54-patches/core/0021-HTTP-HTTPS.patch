diff --git a/v2/config/test_urls.go b/v2/config/test_urls.go
new file mode 100644
index 0000000..ec3b0b9
--- /dev/null
+++ b/v2/config/test_urls.go
@@ -0,0 +1,24 @@
+package config
+
+import "strings"
+
+// defaultTestURLs: the addresses the servers' pings go to. The one the user chose first, then a few known ones, all by the
+// same method (HTTPS when the chosen one is, else HTTP): the pings are one kind of measurement. (Before, the extra ones
+// were fixed and one of them plain HTTP, so a ping the user set to HTTPS was partly measured over HTTP.) A chosen address
+// on a blocked domain is the only one.
+func defaultTestURLs(primary string) []string {
+	if isBlockedConnectionTestUrl(primary) {
+		return []string{primary}
+	}
+	scheme := "https://"
+	if strings.HasPrefix(primary, "http://") {
+		scheme = "http://"
+	}
+	urls := []string{primary}
+	for _, rest := range []string{"www.google.com/generate_204", "captive.apple.com/generate_204", "cp.cloudflare.com/generate_204"} {
+		if candidate := scheme + rest; candidate != primary {
+			urls = append(urls, candidate)
+		}
+	}
+	return urls
+}
diff --git a/v2/config/test_urls_test.go b/v2/config/test_urls_test.go
new file mode 100644
index 0000000..c16a3af
--- /dev/null
+++ b/v2/config/test_urls_test.go
@@ -0,0 +1,37 @@
+package config
+
+import (
+	"strings"
+	"testing"
+)
+
+func TestDefaultTestURLsFollowTheChosenMethod(t *testing.T) {
+	for _, tc := range []struct {
+		primary string
+		scheme  string
+	}{
+		{"https://www.gstatic.com/generate_204", "https://"},
+		{"http://www.gstatic.com/generate_204", "http://"},
+		{"https://cp.cloudflare.com/generate_204", "https://"},
+	} {
+		urls := defaultTestURLs(tc.primary)
+		if urls[0] != tc.primary {
+			t.Fatalf("the chosen address first: %v", urls)
+		}
+		if len(urls) < 3 {
+			t.Fatalf("a few known ones beside it: %v", urls)
+		}
+		for _, u := range urls {
+			if !strings.HasPrefix(u, tc.scheme) {
+				t.Fatalf("%s: %s is not %s", tc.primary, u, tc.scheme)
+			}
+		}
+		seen := map[string]bool{}
+		for _, u := range urls {
+			if seen[u] {
+				t.Fatalf("%s twice in %v", u, urls)
+			}
+			seen[u] = true
+		}
+	}
+}
