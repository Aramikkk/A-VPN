diff --git a/v2/hcore/pause.go b/v2/hcore/pause.go
index dc81cb1..8867343 100644
--- a/v2/hcore/pause.go
+++ b/v2/hcore/pause.go
@@ -53,14 +53,16 @@ func Wake() {
 func SuspendService() error {
 	static.lock.Lock()
 	defer static.lock.Unlock()
-	if static.CoreState != CoreStates_STARTED || static.StartedService == nil {
-		return fmt.Errorf("core is %s", static.CoreState)
+	previous := static.CoreState
+	// WAITING (no ping has decided yet) and NO_AVAILABLE_PROXIES are running states as well
+	if !isRunningState(previous) || static.StartedService == nil {
+		return fmt.Errorf("core is %s", previous)
 	}
 	SetCoreStatus(CoreStates_HOT_RELOADING, MessageType_EMPTY, "")
 	if err := static.StartedService.SuspendService(); err != nil {
 		// A-VPN: not suspended, so still running: back to STARTED, or every later reload and start was refused
 		// as "core is HOT_RELOADING" until the app was killed
-		SetCoreStatus(CoreStates_STARTED, MessageType_EMPTY, "")
+		SetCoreStatus(previous, MessageType_EMPTY, "")
 		return err
 	}
 	return nil
