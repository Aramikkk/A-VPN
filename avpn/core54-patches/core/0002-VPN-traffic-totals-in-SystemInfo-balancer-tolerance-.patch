diff --git a/v2/hcore/vpn_traffic.go b/v2/hcore/vpn_traffic.go
new file mode 100644
index 0000000..252e7f5
--- /dev/null
+++ b/v2/hcore/vpn_traffic.go
@@ -0,0 +1,60 @@
+package hcore
+
+// A-VPN: how much of the traffic went through the provider's servers, as opposed to direct (.ru sites, the
+// local network) or the home WireGuard. Sent as extra fields of SystemInfo, written straight onto the wire so
+// the generated protobuf code doesn't have to change; an app that doesn't know them just ignores them.
+
+import (
+	"strings"
+
+	C "github.com/sagernet/sing-box/constant"
+	"google.golang.org/protobuf/encoding/protowire"
+)
+
+const (
+	vpnUplinkTotalField   protowire.Number = 100
+	vpnDownlinkTotalField protowire.Number = 101
+)
+
+// isProviderServer reports whether traffic credited to an outbound of this type and tag went through a VPN
+// server: not direct, not blocked, not a group (groups are never credited) and not the home network.
+func isProviderServer(outboundType, tag string) bool {
+	switch outboundType {
+	case C.TypeDirect, C.TypeBlock, C.TypeDNS, C.TypeSelector, C.TypeURLTest:
+		return false
+	}
+	return !strings.HasPrefix(tag, "🏠")
+}
+
+// vpnTraffic sums the traffic of every provider server of the running box.
+func (h *HiddifyInstance) vpnTraffic() (up, down int64) {
+	box, manager := h.Box(), h.TrafficManager()
+	if box == nil || manager == nil {
+		return 0, 0
+	}
+	add := func(outboundType, tag string) {
+		if !isProviderServer(outboundType, tag) {
+			return
+		}
+		u, d := manager.OutboundUsage(tag)
+		up += u
+		down += d
+	}
+	for _, outbound := range box.Outbound().Outbounds() {
+		add(outbound.Type(), outbound.Tag())
+	}
+	for _, endpoint := range box.Endpoint().Endpoints() {
+		add(endpoint.Type(), endpoint.Tag())
+	}
+	return up, down
+}
+
+// withVpnTraffic adds the VPN totals to message as fields the generated code doesn't know.
+func withVpnTraffic(message *SystemInfo, up, down int64) {
+	var raw []byte
+	raw = protowire.AppendTag(raw, vpnUplinkTotalField, protowire.VarintType)
+	raw = protowire.AppendVarint(raw, uint64(up))
+	raw = protowire.AppendTag(raw, vpnDownlinkTotalField, protowire.VarintType)
+	raw = protowire.AppendVarint(raw, uint64(down))
+	message.ProtoReflect().SetUnknown(raw)
+}
diff --git a/v2/hcore/vpn_traffic_test.go b/v2/hcore/vpn_traffic_test.go
new file mode 100644
index 0000000..3db448e
--- /dev/null
+++ b/v2/hcore/vpn_traffic_test.go
@@ -0,0 +1,48 @@
+package hcore
+
+import (
+	"testing"
+
+	"google.golang.org/protobuf/encoding/protowire"
+	"google.golang.org/protobuf/proto"
+)
+
+func TestVpnTrafficSurvivesTheWire(t *testing.T) {
+	message := &SystemInfo{UplinkTotal: 10, DownlinkTotal: 20}
+	withVpnTraffic(message, 3, 7)
+	raw, err := proto.Marshal(message)
+	if err != nil {
+		t.Fatal(err)
+	}
+	got := map[protowire.Number]uint64{}
+	for len(raw) > 0 {
+		num, typ, n := protowire.ConsumeTag(raw)
+		raw = raw[n:]
+		if typ != protowire.VarintType {
+			t.Fatalf("field %d: unexpected wire type %d", num, typ)
+		}
+		v, m := protowire.ConsumeVarint(raw)
+		raw = raw[m:]
+		got[num] = v
+	}
+	if got[8] != 10 || got[9] != 20 || got[vpnUplinkTotalField] != 3 || got[vpnDownlinkTotalField] != 7 {
+		t.Fatalf("fields on the wire: %v", got)
+	}
+}
+
+func TestOnlyProviderServersCount(t *testing.T) {
+	cases := map[[2]string]bool{
+		{"vless", "🇩🇪 Доступ - Германия § 3"}: true,
+		{"hysteria2", "LTE Only § 9"}:         true,
+		{"direct", "direct §hide§"}:           false,
+		{"block", "block"}:                    false,
+		{"selector", "select"}:                false,
+		{"urltest", "auto"}:                   false,
+		{"wireguard", "🏠 Mechta §hide§"}:      false,
+	}
+	for c, want := range cases {
+		if got := isProviderServer(c[0], c[1]); got != want {
+			t.Errorf("%v: got %v, want %v", c, got, want)
+		}
+	}
+}
