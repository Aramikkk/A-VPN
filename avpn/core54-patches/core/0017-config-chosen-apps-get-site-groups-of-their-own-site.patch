+
+// AppGroupTagPrefix starts the tag of a chosen app's group: "app-" and its package name.
+const AppGroupTagPrefix = "app-"
+
+// siteGroupAppServices: the apps of the services the app times, tested against their service's page.
+var siteGroupAppServices = map[string]string{
+	"com.instagram.android":        "instagram",
+	"com.instagram.lite":           "instagram",
+	"com.whatsapp":                 "whatsapp",
+	"com.whatsapp.w4b":             "whatsapp",
+	"org.telegram.messenger":       "telegram",
+	"org.telegram.messenger.web":   "telegram",
+	"org.telegram.plus":            "telegram",
+	"org.thunderdog.challegram":    "telegram",
+	"com.openai.chatgpt":           "chatgpt",
+	"com.google.android.youtube":   "youtube",
+	"app.revanced.android.youtube": "youtube",
+	"com.google.android.apps.docs": "gdrive",
+}
+
+// siteGroupOutbound is a service's or an app's group: a URL test over the servers against [url].
+func siteGroupOutbound(tag, url string, servers []string, tolerance uint16) option.Outbound {
+	return option.Outbound{
+		Type: C.TypeURLTest,
+		Tag:  tag,
+		Options: &option.URLTestOutboundOptions{
+			Outbounds: servers,
+			URL:       url,
+			// tested every two minutes, and only while the service is used (idle half an hour: no tests)
+			Interval:    badoption.Duration(2 * time.Minute),
+			IdleTimeout: badoption.Duration(30 * time.Minute),
+			// another server only when it's sooner by this much (the app's setting), so the service doesn't hop
+			Tolerance: tolerance,
+			// what's open stays where it is (a call, a video); new connections go through the new one
+			InterruptExistConnections: false,
+			// its own results: they mustn't take the place of the servers' pings the app shows
+			PrivateHistory: true,
+			// the first minute after the start, a network change or a pause: through the main choice (the servers'
+			// pings and Auto settle first), the group's own tests already running
+			WarmUp:       badoption.Duration(time.Minute),
+			WarmUpDetour: OutboundSelectTag,
+			// a server only after three tests in a row answered (three in the warm-up minute, then one each
+			// round), by their average; until one has, the main choice, never the first server listed
+			StableSamples: 3,
+			// a test through a whitelist server on mobile data takes longer than the 5 s default
+			TestTimeout: badoption.Duration(10 * time.Second),
+		},
+	}
+}
+
+// siteGroupRule sends what [match] matches to the group [tag].
+func siteGroupRule(tag string, match option.RawDefaultRule) option.Rule {
+	return option.Rule{
+		Type: C.RuleTypeDefault,
+		DefaultOptions: option.DefaultRule{
+			RawDefaultRule: match,
+			RuleAction: option.RuleAction{
+				Action:       C.RuleActionTypeRoute,
+				RouteOptions: option.RouteActionOptions{Outbound: tag},
+			},
+		},
+	}
+}
diff --git a/v2/config/site_groups_test.go b/v2/config/site_groups_test.go
index 04ddd83..9659f7b 100644
--- a/v2/config/site_groups_test.go
+++ b/v2/config/site_groups_test.go
@@ -179,3 +179,32 @@ func TestSiteGroupsPerNetworkFromInput(t *testing.T) {
 		t.Fatalf("the choice mustn't reach the running config: %+v", mon)
 	}
 }
+
+// The apps the user chose get groups of their own, their rules first; a known service's app tests its page.
+func TestSiteGroupApps(t *testing.T) {
+	options := siteGroupsTestOptions()
+	applySiteGroups(options, &HiddifyOptions{URLTestOptions: URLTestOptions{
+		SiteGroups:        true,
+		SiteGroupApps:     []string{"com.instagram.android", "ru.example.bank", "com.instagram.android"},
+		ConnectionTestUrl: "http://cp.cloudflare.com/",
+	}})
+	urls := map[string]string{}
+	for _, out := range options.Outbounds {
+		if out.Type == C.TypeURLTest {
+			urls[out.Tag] = out.Options.(*option.URLTestOutboundOptions).URL
+		}
+	}
+	if len(urls) != len(siteGroups)+2 {
+		t.Fatalf("%d groups, want %d (a chosen app once)", len(urls), len(siteGroups)+2)
+	}
+	if urls[AppGroupTagPrefix+"com.instagram.android"] != "https://www.instagram.com/" {
+		t.Fatalf("Instagram's app tests Instagram: %q", urls[AppGroupTagPrefix+"com.instagram.android"])
+	}
+	if urls[AppGroupTagPrefix+"ru.example.bank"] != "http://cp.cloudflare.com/" {
+		t.Fatalf("another app tests the servers' address: %q", urls[AppGroupTagPrefix+"ru.example.bank"])
+	}
+	rule := options.Route.Rules[3].DefaultOptions
+	if rule.RouteOptions.Outbound != AppGroupTagPrefix+"com.instagram.android" || rule.PackageName[0] != "com.instagram.android" {
+		t.Fatalf("the apps' rules come first: %+v", rule)
+	}
+}
