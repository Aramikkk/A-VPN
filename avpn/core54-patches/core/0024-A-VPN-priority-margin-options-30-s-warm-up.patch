diff --git a/v2/config/site_groups.go b/v2/config/site_groups.go
index e58302c..303f2a7 100644
--- a/v2/config/site_groups.go
+++ b/v2/config/site_groups.go
@@ -290,11 +290,11 @@ func siteGroupOutbound(tag, url string, probes []string, servers []string, toler
 			InterruptExistConnections: false,
 			// its own results: they mustn't take the place of the servers' pings the app shows
 			PrivateHistory: true,
-			// the first minute after the start, a network change or a pause: through the main choice (the servers'
+			// the first half minute after the start, a network change or a pause: through the main choice (the servers'
 			// pings and Auto settle first), the group's own tests already running
-			WarmUp:       badoption.Duration(time.Minute),
+			WarmUp:       badoption.Duration(30 * time.Second),
 			WarmUpDetour: OutboundSelectTag,
-			// a server only after three tests in a row answered (three in the warm-up minute, then one each
+			// a server only after three tests in a row answered (three in the warm-up half minute, then one each
 			// round), by their average; until one has, the main choice, never the first server listed
 			StableSamples: 3,
 			// a server in use stays at least ten minutes after the last switch while it answers every test: a service
@@ -304,6 +304,9 @@ func siteGroupOutbound(tag, url string, probes []string, servers []string, toler
 			TestTimeout: badoption.Duration(10 * time.Second),
 			// the AI chats: the server stays until it stops answering
 			Sticky: sticky,
+			// only the five best servers by the shared pings are tested (a handshake per server per URL each round: over
+			// forty servers took five times the processor of the whole core in the first minutes)
+			Candidates: 5,
 		},
 	}
 }
