Subject: [PATCH 24/29] A-VPN: priority/margin options, 30 s warm-up

---
 v2/config/builder.go          | 40 ++++++++++++++++++++++++++++++++++-
 v2/config/h_priority_test.go  | 15 +++++++++++++
 v2/config/hiddify_option.go   |  3 +++
 v2/config/site_groups.go      |  9 +++++---
 v2/config/site_groups_test.go |  2 +-
 5 files changed, 64 insertions(+), 5 deletions(-)
 create mode 100644 v2/config/h_priority_test.go

diff --git a/v2/config/builder.go b/v2/config/builder.go
index b438272..97e2249 100644
--- a/v2/config/builder.go
+++ b/v2/config/builder.go
@@ -8,6 +8,8 @@ import (
 	"net"
 	"net/netip"
 	"net/url"
+	"regexp"
+	"strconv"
 	"strings"
 	sync "sync"
 	"time"
@@ -78,6 +80,8 @@ func BuildConfig(ctx context.Context, hopts *HiddifyOptions, inputOpt *ReadOptio
 		if tolerance := input.Experimental.Monitoring.SiteGroupsTolerance; tolerance > 0 {
 			local.SiteGroupsTolerance = tolerance
 		}
+		local.PriorityProfile = input.Experimental.Monitoring.PriorityProfile
+		local.PriorityMargin = input.Experimental.Monitoring.PriorityMargin
 		hopts = &local
 		value := input.Experimental.Monitoring.URLTestTimeout
 		if value.Build() >= time.Second && value.Build() <= 30*time.Second {
@@ -291,6 +295,9 @@ func setOutbounds(options *option.Options, input *option.Options, opt *HiddifyOp
 			Tolerance: balancerTolerance(opt, false),
 			// IdleTimeout:               badoption.Duration(opt.URLTestInterval.Duration().Nanoseconds() * 3),
 			InterruptExistConnections: !opt.BalancerKeepConnections,
+			PriorityOutbounds:         priorityTags(tags, opt.PriorityProfile),
+			PriorityMargin:            opt.PriorityMargin,
+			SmoothSamples:             3,
 		},
 	}
 
@@ -390,7 +397,7 @@ func setExperimental(options *option.Options, hopt *HiddifyOptions) {
 	timeout := badoption.Duration(hopt.URLTestTimeout.Duration())
 	if options.Experimental != nil && options.Experimental.Monitoring != nil {
 		candidate := options.Experimental.Monitoring.URLTestTimeout
-		if candidate.Build() >= time.Second && candidate.Build() <= 30*time.Second {
+		if candidate.Build() >= time.Second && candidate.Build() <= 120*time.Second {
 			timeout = candidate
 		}
 	}
@@ -1318,3 +1325,34 @@ func balancerTolerance(opt *HiddifyOptions, mobile bool) uint16 {
 	}
 	return 1
 }
+
+// profileStep is how far apart the app numbers the servers of the merged subscriptions (profile_merge.dart): the
+// first added profile's servers end in § 1001..., the second's in § 2001...
+const profileStep = 1000
+
+var tagEnding = regexp.MustCompile(`§\s*(\d+)\s*$`)
+
+// profileOfTag is which subscription of the merged config a server is from: 1 the active profile's, 2 the first
+// added, and so on.
+func profileOfTag(tag string) int {
+	if m := tagEnding.FindStringSubmatch(tag); m != nil {
+		if n, err := strconv.Atoi(m[1]); err == nil {
+			return n/profileStep + 1
+		}
+	}
+	return 1
+}
+
+// priorityTags are the servers of the priority subscription (profile, 1-based; 0 = none).
+func priorityTags(tags []string, profile int) []string {
+	if profile <= 0 {
+		return nil
+	}
+	var res []string
+	for _, tag := range tags {
+		if profileOfTag(tag) == profile {
+			res = append(res, tag)
+		}
+	}
+	return res
+}
diff --git a/v2/config/h_priority_test.go b/v2/config/h_priority_test.go
new file mode 100644
index 0000000..d3d5e2f
--- /dev/null
+++ b/v2/config/h_priority_test.go
@@ -0,0 +1,15 @@
+package config
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestPriorityTags(t *testing.T) {
+	tags := []string{"PL § 3", "DE § 12", "PL § 1003", "EE § 1001", "NL § 2005", "plain"}
+	require.Equal(t, []string{"PL § 3", "DE § 12", "plain"}, priorityTags(tags, 1))
+	require.Equal(t, []string{"PL § 1003", "EE § 1001"}, priorityTags(tags, 2))
+	require.Equal(t, []string{"NL § 2005"}, priorityTags(tags, 3))
+	require.Nil(t, priorityTags(tags, 0))
+}
diff --git a/v2/config/hiddify_option.go b/v2/config/hiddify_option.go
