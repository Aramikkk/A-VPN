 v2/config/builder.go                |  18 ++++
 v2/config/hiddify_option.go         |   2 +
 v2/config/input_route_rules_test.go | 135 ++++++++++++++++++++++++++++
 4 files changed, 156 insertions(+), 1 deletion(-)
 create mode 100644 v2/config/input_route_rules_test.go

diff --git a/hiddify-sing-box b/hiddify-sing-box
index 004371d..f685aa9 160000
--- a/hiddify-sing-box
+++ b/hiddify-sing-box
@@ -1 +1 @@
-Subproject commit 004371d6be2395ee4379054a8cf113f339dbe231
+Subproject commit f685aa92f63b751e0879227efc698a45f76b9ced
diff --git a/v2/config/builder.go b/v2/config/builder.go
index 5e449ab..3bf2224 100644
--- a/v2/config/builder.go
+++ b/v2/config/builder.go
@@ -92,10 +92,27 @@ func BuildConfig(ctx context.Context, hopts *HiddifyOptions, inputOpt *ReadOptio
 	if err := setRoutingOptions(&options, hopts); err != nil {
 		return nil, err
 	}
+	prependInputRouteRules(&options, input)
 
 	return &options, nil
 }
 
+// prependInputRouteRules keeps the route rules written into the config the app starts the core with (A-VPN
+// adds one that sends a home network to a WireGuard endpoint it adds alongside). Parsed provider profiles
+// carry no route rules, so only those reach here. They go right after sniffing and DNS hijacking, before
+// every built-in and app rule, so a home network isn't sent direct as a private range first.
+func prependInputRouteRules(options *option.Options, input *option.Options) {
+	if input == nil || input.Route == nil || len(input.Route.Rules) == 0 || options.Route == nil {
+		return
+	}
+	head := min(2, len(options.Route.Rules))
+	rules := make([]option.Rule, 0, len(options.Route.Rules)+len(input.Route.Rules))
+	rules = append(rules, options.Route.Rules[:head]...)
+	rules = append(rules, input.Route.Rules...)
+	rules = append(rules, options.Route.Rules[head:]...)
+	options.Route.Rules = rules
+}
+
 // dialDetour maps the built-in empty direct outbounds to "" (dial directly),
 // since sing-box rejects a detour to an empty direct outbound.
 func dialDetour(tag string) string {
@@ -387,6 +404,7 @@ func setExperimental(options *option.Options, hopt *HiddifyOptions) {
 				IpInfoURL:      hopt.IpInfoUrl,
 				Interval:       badoption.Duration(hopt.URLTestInterval.Duration()),
 				DebounceWindow: badoption.Duration(time.Millisecond * 500),
+				URLTestTimeout: badoption.Duration(hopt.URLTestTimeout.Duration()),
 				IdleTimeout:    badoption.Duration(hopt.URLTestInterval.Duration().Nanoseconds() * 3),
 			},
 		}
