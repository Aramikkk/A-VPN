index 0000000..b6d23a8
--- /dev/null
+++ b/v2/config/input_route_rules_test.go
@@ -0,0 +1,135 @@
+package config
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+// A start config as A-VPN writes it: the provider's servers, a WireGuard endpoint for the home network,
+// and a rule sending the home network to that endpoint.
+const homeNetworkProfile = `{
+  "outbounds": [{"type": "socks", "tag": "proxy-a", "server": "127.0.0.1", "server_port": 1080}],
+  "endpoints": [{"type": "wireguard", "tag": "home §hide§", "address": ["192.168.99.198/32"],
+    "private_key": "YNZ1j9cQaXg0yRtj3yJ8gBf7JbXg5mJcVZ5D2P5m+3E=",
+    "peers": [{"address": "203.0.113.1", "port": 8443,
+      "public_key": "yR/S2c+QvLGTFCec7QyO02tzJq6XduLOrcDZsJ66JCw=",
+      "allowed_ips": ["192.168.1.0/24", "192.168.88.1/32"],
+      "persistent_keepalive_interval": 300}]}],
+  "route": {"rules": [{"ip_cidr": ["192.168.1.0/24", "192.168.88.1/32"], "action": "route", "outbound": "home §hide§"}]}
+}`
+
+func TestHomeNetworkRuleSurvivesBuild(t *testing.T) {
+	options, err := BuildConfig(libbox.BaseContext(nil), DefaultHiddifyOptions(), &ReadOptions{Content: homeNetworkProfile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if err := libbox.CheckConfigOptions(options); err != nil {
+		t.Fatalf("sing-box rejects the config: %v", err)
+	}
+
+	rules := options.Route.Rules
+	if len(rules) < 3 {
+		t.Fatalf("too few rules: %d", len(rules))
+	}
+	if rules[0].DefaultOptions.Action != C.RuleActionTypeSniff || rules[1].DefaultOptions.Action != C.RuleActionTypeHijackDNS {
+		t.Fatalf("sniff and DNS hijack must stay first")
+	}
+	home := rules[2].DefaultOptions
+	if home.RouteOptions.Outbound != "home §hide§" || len(home.IPCIDR) != 2 {
+		t.Fatalf("the home rule must come right after them, got %+v", home)
+	}
+
+	found := false
+	for _, endpoint := range options.Endpoints {
+		if endpoint.Tag == "home §hide§" {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatalf("the WireGuard endpoint is missing from the built config")
+	}
+	for _, outbound := range options.Outbounds {
+		if outbound.Type == C.TypeSelector {
+			for _, tag := range outbound.Options.(*option.SelectorOutboundOptions).Outbounds {
+				if tag == "home §hide§" {
+					t.Fatalf("the home endpoint must stay out of the server selector")
+				}
+			}
+		}
+	}
+}
+
+func TestNoInputRulesLeavesBuiltinsAlone(t *testing.T) {
+	options := &option.Options{Route: &option.RouteOptions{Rules: []option.Rule{{Type: C.RuleTypeDefault}}}}
+	prependInputRouteRules(options, &option.Options{})
+	if len(options.Route.Rules) != 1 {
+		t.Fatalf("rules changed without input rules: %d", len(options.Route.Rules))
+	}
+}
+
+// On mobile data A-VPN sends the home WireGuard through the server selector (an "LTE Only" server passes the
+// operator's whitelist where the home server's address doesn't).
+func TestHomeNetworkThroughSelector(t *testing.T) {
+	profile := strings.Replace(homeNetworkProfile, `"address": ["192.168.99.198/32"],`,
+		`"address": ["192.168.99.198/32"], "detour": "select",`, 1)
+	options, err := BuildConfig(libbox.BaseContext(nil), DefaultHiddifyOptions(), &ReadOptions{Content: profile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if err := libbox.CheckConfigOptions(options); err != nil {
+		t.Fatalf("sing-box rejects a WireGuard endpoint detoured through the selector: %v", err)
+	}
+	for _, endpoint := range options.Endpoints {
+		if endpoint.Tag != "home §hide§" {
+			continue
+		}
+		wg := endpoint.Options.(*option.WireGuardEndpointOptions)
+		if wg.Detour != "select" {
+			t.Fatalf("detour lost: %q", wg.Detour)
+		}
+		if wg.MTU == 0 || wg.MTU > 1280 {
+			t.Fatalf("a detoured WireGuard needs the smaller MTU, got %d", wg.MTU)
+		}
+		return
+	}
+	t.Fatalf("home endpoint missing")
+}
+
+// A-VPN's "Server" mode: the home network through WireGuard, every other connection direct, so the provider's
+// servers carry nothing.
+func TestServerModeSendsEverythingElseDirect(t *testing.T) {
+	profile := strings.Replace(homeNetworkProfile,
+		`"route": {"rules": [{"ip_cidr": ["192.168.1.0/24", "192.168.88.1/32"], "action": "route", "outbound": "home §hide§"}]}`,
+		`"route": {"rules": [{"ip_cidr": ["192.168.1.0/24", "192.168.88.1/32"], "action": "route", "outbound": "home §hide§"},
+		  {"network": ["tcp", "udp"], "action": "route", "outbound": "direct §hide§"}]}`, 1)
+	options, err := BuildConfig(libbox.BaseContext(nil), DefaultHiddifyOptions(), &ReadOptions{Content: profile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if err := libbox.CheckConfigOptions(options); err != nil {
+		t.Fatalf("sing-box rejects the server-mode config: %v", err)
+	}
+	direct := options.Route.Rules[3].DefaultOptions
+	if direct.RouteOptions.Outbound != OutboundDirectTag || len(direct.Network) != 2 {
+		t.Fatalf("the catch-all direct rule must follow the home rule, got %+v", direct)
+	}
+}
+
+
+// A-VPN's ping timeout setting reaches the core's server monitoring.
+func TestURLTestTimeoutReachesMonitoring(t *testing.T) {
+	hopt := DefaultHiddifyOptions()
+	hopt.URLTestTimeout = 3
+	options, err := BuildConfig(libbox.BaseContext(nil), hopt, &ReadOptions{Content: homeNetworkProfile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if got := options.Experimental.Monitoring.URLTestTimeout.Build(); got != 3*time.Second {
+		t.Fatalf("url test timeout = %v, want 3s", got)
+	}
+}
