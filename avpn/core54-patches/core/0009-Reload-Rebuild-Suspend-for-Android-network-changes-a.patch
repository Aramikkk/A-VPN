@@ -2,6 +2,7 @@ package hcore
 
 import (
 	"context"
+	"fmt"
 	"time"
 
 	hcommon "github.com/hiddify/hiddify-core/v2/hcommon"
@@ -47,3 +48,14 @@ func Wake() {
 	}
 
 }
+
+// SuspendService retains the daemon so RebuildService resumes the same session.
+func SuspendService() error {
+	static.lock.Lock()
+	defer static.lock.Unlock()
+	if static.CoreState != CoreStates_STARTED || static.StartedService == nil {
+		return fmt.Errorf("core is %s", static.CoreState)
+	}
+	SetCoreStatus(CoreStates_HOT_RELOADING, MessageType_EMPTY, "")
+	return static.StartedService.SuspendService()
+}
