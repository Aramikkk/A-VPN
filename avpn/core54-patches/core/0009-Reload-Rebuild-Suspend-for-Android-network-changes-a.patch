@@ -0,0 +1,82 @@
+package hcore
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	"github.com/hiddify/hiddify-core/v2/hcommon"
+	"github.com/hiddify/hiddify-core/v2/hello"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/credentials/insecure"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+func TestInsecureGrpcRejectsUnauthenticatedRPCs(t *testing.T) {
+	for _, mode := range []SetupMode{SetupMode_GRPC_NORMAL_INSECURE, SetupMode_GRPC_BACKGROUND_INSECURE} {
+		t.Run(mode.String(), func(t *testing.T) {
+			listener, err := net.Listen("tcp", "127.0.0.1:0")
+			if err != nil {
+				t.Fatal(err)
+			}
+			address := listener.Addr().String()
+			listener.Close()
+			secret := "test-secret-with-at-least-32-random-bytes"
+			server, err := StartGrpcServerByMode(address, mode, secret)
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer server.Stop()
+			defer delete(grpcServer, mode)
+			conn, err := grpc.NewClient(address, grpc.WithTransportCredentials(insecure.NewCredentials()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer conn.Close()
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			_, err = hello.NewHelloClient(conn).SayHello(ctx, &hello.HelloRequest{Name: "test"})
+			if status.Code(err) != codes.Unauthenticated {
+				t.Errorf("unary RPC: want Unauthenticated, got %v", err)
+			}
+			wrong := metadata.AppendToOutgoingContext(ctx, "authorization", "Bearer wrong")
+			_, err = hello.NewHelloClient(conn).SayHello(wrong, &hello.HelloRequest{Name: "test"})
+			if status.Code(err) != codes.Unauthenticated {
+				t.Errorf("wrong token: got %v", err)
+			}
+			stream, err := NewCoreClient(conn).GetSystemInfoStream(ctx, &hcommon.Empty{})
+			if err == nil {
+				_, err = stream.Recv()
+			}
+			if status.Code(err) != codes.Unauthenticated {
+				t.Errorf("stream RPC: want Unauthenticated, got %v", err)
+			}
+			valid := metadata.AppendToOutgoingContext(ctx, "authorization", "Bearer "+secret)
+			if _, err := hello.NewHelloClient(conn).SayHello(valid, &hello.HelloRequest{Name: "test"}); err != nil {
+				t.Fatalf("authenticated unary: %v", err)
+			}
+			info, err := NewCoreClient(conn).CoreInfoListener(valid, &hcommon.Empty{})
+			if err == nil {
+				_, err = info.Recv()
+			}
+			if err != nil {
+				t.Fatalf("authenticated stream: %v", err)
+			}
+		})
+	}
+}
+
+func TestGrpcAuthenticationRequiresSecret(t *testing.T) {
+	if _, err := grpcAuthenticationOptions(); err == nil {
+		t.Fatal("missing secret accepted")
+	}
+	if _, err := grpcAuthenticationOptions(""); err == nil {
+		t.Fatal("empty secret accepted")
+	}
+	if _, err := grpcAuthenticationOptions("short"); err == nil {
+		t.Fatal("short secret accepted")
+	}
+}
