+// HotReloadRunning never starts a stopped core, including when Stop won the queue.
+func HotReloadRunning(ctx context.Context, in *StartRequest) (*CoreInfoResponse, error) {
+	queue.Lock()
+	ctx = withStopSignalLocked(ctx)
+	setCoreStatusIf(append([]CoreStates{CoreStates_HOT_RELOADING}, running...), CoreStates_HOT_RELOADING, MessageType_EMPTY, "")
+	result := enqueueLocked(operationStart, "hotreload", func() (coreResponse *CoreInfoResponse, err error) {
+		defer config.DeferPanicToError("hotreload", func(recovered_err error) {
+			coreResponse, err = hotReloadError(MessageType_UNEXPECTED_ERROR, recovered_err)
+		})
+		return hotReloadLockedMode(ctx, in, true)
+	})
+	queue.Unlock()
+	return wait(result)
+}
+
+// RebuildService replaces an incompatible box inside the same logical session.
+// Unlike Stop/Start, the daemon retains its original session start time.
+func RebuildService(ctx context.Context, in *StartRequest) (*CoreInfoResponse, error) {
+	queue.Lock()
+	ctx = withStopSignalLocked(ctx)
+	result := enqueueLocked(operationStart, "rebuild", func() (coreResponse *CoreInfoResponse, err error) {
+		defer config.DeferPanicToError("rebuild", func(recovered_err error) {
+			coreResponse, err = hotReloadError(MessageType_UNEXPECTED_ERROR, recovered_err)
+		})
+		return rebuildLocked(ctx, in)
+	})
+	queue.Unlock()
+	return wait(result)
+}
+
+// rebuildLocked is RebuildService; static.lock must be held.
+func rebuildLocked(ctx context.Context, in *StartRequest) (*CoreInfoResponse, error) {
+	state := currentCoreState()
+	if !isRunningState(state) || static.StartedService == nil {
+		return hotReloadError(MessageType_HOT_RELOAD_FAILED, fmt.Errorf("core is %s", state))
+	}
+	in, err := loadLastStartRequestIfNeeded(in)
+	if err != nil {
+		return hotReloadError(MessageType_ERROR_BUILDING_CONFIG, err)
+	}
+	options, err := BuildConfig(ctx, in)
+	if err != nil {
+		return hotReloadError(MessageType_ERROR_BUILDING_CONFIG, err)
+	}
+	if err = service_manager.OnMainServicePreStart(options); err != nil {
+		return hotReloadError(MessageType_ERROR_EXTENSION, err)
+	}
+	if err = libbox.CheckConfigOptions(options); err != nil {
+		return hotReloadError(MessageType_ERROR_BUILDING_CONFIG, err)
+	}
+	content, err := json.MarshalContext(ctx, options)
+	if err != nil {
+		return hotReloadError(MessageType_ERROR_BUILDING_CONFIG, err)
+	}
+	SetCoreStatus(CoreStates_HOT_RELOADING, MessageType_EMPTY, "")
+	if err = static.StartedService.StartOrReloadService(ctx, string(content), nil); err != nil {
+		// Keep the daemon so the caller can rebuild the previous configuration
+		// without losing the session after a failed replacement.
+		setCoreStatusIf([]CoreStates{CoreStates_HOT_RELOADING}, static.connectedState(), MessageType_EMPTY, "")
+		return hotReloadError(MessageType_START_SERVICE, err)
+	}
+	static.previousStartRequest = in
+	saveLastStartRequest(in)
+	config.SaveCurrentConfig(ctx, filepath.Join(sWorkingPath, "data/current-config.json"), *options)
+	if response, ok := setCoreStatusIf([]CoreStates{CoreStates_HOT_RELOADING}, CoreStates_WAITING, MessageType_EMPTY, ""); ok {
+		startConnectivityWatcher()
+		return response, nil
+	}
+	return &CoreInfoResponse{CoreState: currentCoreState(), MessageType: MessageType_EMPTY}, nil
+}
+
+func isRunningState(state CoreStates) bool {
+	for _, candidate := range running {
+		if candidate == state {
+			return true
+		}
+	}
+	return false
+}
+
 // hotReloadLocked is HotReload; static.lock must be held.
 func hotReloadLocked(ctx context.Context, in *StartRequest) (*CoreInfoResponse, error) {
+	return hotReloadLockedMode(ctx, in, false)
+}
+
+// hotReloadLockedMode is hotReloadLocked; runningOnly refuses to start a stopped core.
+func hotReloadLockedMode(ctx context.Context, in *StartRequest, runningOnly bool) (*CoreInfoResponse, error) {
 	if err := contextErr(ctx); err != nil {
 		return hotReloadError(MessageType_HOT_RELOAD_FAILED, fmt.Errorf("hot reload cancelled: %w", err))
 	}
 	switch currentCoreState() {
 	case CoreStates_STOPPED:
+		if runningOnly {
+			return hotReloadError(MessageType_HOT_RELOAD_FAILED, fmt.Errorf("core is %s", CoreStates_STOPPED))
+		}
 		return startServiceLocked(ctx, in)
 	case CoreStates_WAITING, CoreStates_STARTED, CoreStates_NO_AVAILABLE_PROXIES, CoreStates_HOT_RELOADING:
 		// HOT_RELOADING may already be set when the call was accepted (shown at once)
