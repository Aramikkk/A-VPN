@@ -0,0 +1,52 @@
+package config
+
+import (
+	"context"
+	"net/netip"
+	"path/filepath"
+	"testing"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/dns/transport/fakeip"
+	"github.com/sagernet/sing-box/experimental/cachefile"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing/common/logger"
+	"github.com/sagernet/sing/service"
+	"github.com/stretchr/testify/require"
+)
+
+func TestFakeIPMappingsSurviveRestart(t *testing.T) {
+	options := DefaultHiddifyOptions()
+	options.EnableFakeDNS = true
+	options.EnableClashApi = true
+	built, err := BuildConfig(libbox.BaseContext(nil), options, &ReadOptions{Content: `{"outbounds":[{"type":"socks","tag":"proxy","server":"127.0.0.1","server_port":1080}]}`})
+	require.NoError(t, err)
+	cacheOptions := *built.Experimental.CacheFile
+	cacheOptions.Path = filepath.Join(t.TempDir(), "cache.db")
+	open := func() (*fakeip.Store, *cachefile.CacheFile) {
+		t.Helper()
+		ctx := context.Background()
+		cache := cachefile.New(ctx, logger.NOP(), cacheOptions)
+		require.NoError(t, cache.Start(adapter.StartStateInitialize))
+		ctx = service.ContextWith[adapter.CacheFile](ctx, cache)
+		store := fakeip.NewStore(ctx, logger.NOP(), netip.MustParsePrefix("198.18.0.0/15"), netip.MustParsePrefix("fc00::/18"))
+		require.NoError(t, store.Start())
+		return store, cache
+	}
+	store, cache := open()
+	ip4, err := store.Create("cached-v4.example", false)
+	require.NoError(t, err)
+	ip6, err := store.Create("cached-v6.example", true)
+	require.NoError(t, err)
+	require.NoError(t, store.Close())
+	require.NoError(t, cache.Close())
+	store, cache = open()
+	defer cache.Close()
+	defer store.Close()
+	name4, found4 := store.Lookup(ip4)
+	name6, found6 := store.Lookup(ip6)
+	require.True(t, found4, "cached IPv4 fake address lost after restart")
+	require.True(t, found6, "cached IPv6 fake address lost after restart")
+	require.Equal(t, "cached-v4.example", name4)
+	require.Equal(t, "cached-v6.example", name6)
+}
