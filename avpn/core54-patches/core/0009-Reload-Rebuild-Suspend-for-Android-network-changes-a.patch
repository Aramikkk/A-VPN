diff --git a/v2/hcore/grpc_auth.go b/v2/hcore/grpc_auth.go
new file mode 100644
index 0000000..1008995
--- /dev/null
+++ b/v2/hcore/grpc_auth.go
@@ -0,0 +1,43 @@
+package hcore
+
+import (
+	"context"
+	"crypto/subtle"
+	"fmt"
+
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/codes"
+	"google.golang.org/grpc/metadata"
+	"google.golang.org/grpc/status"
+)
+
+// Plaintext loopback is shared with other local applications. Every RPC needs
+// the install secret, including hello and server-streaming subscriptions.
+func grpcAuthenticationOptions(secrets ...string) ([]grpc.ServerOption, error) {
+	if len(secrets) != 1 || len(secrets[0]) < 32 {
+		return nil, fmt.Errorf("gRPC requires an authentication secret of at least 32 bytes")
+	}
+	expected := "Bearer " + secrets[0]
+	authenticate := func(ctx context.Context) error {
+		md, _ := metadata.FromIncomingContext(ctx)
+		values := md.Get("authorization")
+		if len(values) != 1 || subtle.ConstantTimeCompare([]byte(values[0]), []byte(expected)) != 1 {
+			return status.Error(codes.Unauthenticated, "invalid gRPC credentials")
+		}
+		return nil
+	}
+	return []grpc.ServerOption{
+		grpc.UnaryInterceptor(func(ctx context.Context, req any, info *grpc.UnaryServerInfo, handler grpc.UnaryHandler) (any, error) {
+			if err := authenticate(ctx); err != nil {
+				return nil, err
+			}
+			return handler(ctx, req)
+		}),
+		grpc.StreamInterceptor(func(srv any, stream grpc.ServerStream, info *grpc.StreamServerInfo, handler grpc.StreamHandler) error {
+			if err := authenticate(stream.Context()); err != nil {
+				return err
+			}
+			return handler(srv, stream)
+		}),
+	}, nil
+}
diff --git a/v2/hcore/grpc_auth_test.go b/v2/hcore/grpc_auth_test.go
