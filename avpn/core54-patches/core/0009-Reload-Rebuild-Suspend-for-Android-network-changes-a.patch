@@ -0,0 +1,41 @@
+package config
+
+import (
+	"encoding/json"
+	"testing"
+)
+
+func TestNetworkSpecificBalancerTolerance(t *testing.T) {
+	options := DefaultHiddifyOptions()
+	options.BalancerTolerance = 150
+	options.BalancerToleranceWifi = 150
+	options.BalancerToleranceMobile = 50
+
+	if got := balancerTolerance(options, false); got != 150 {
+		t.Fatalf("Wi-Fi tolerance = %d, want 150", got)
+	}
+	if got := balancerTolerance(options, true); got != 50 {
+		t.Fatalf("LTE tolerance = %d, want 50", got)
+	}
+
+	options.BalancerToleranceWifi = 0
+	options.BalancerToleranceMobile = 0
+	if got := balancerTolerance(options, true); got != 150 {
+		t.Fatalf("legacy LTE tolerance = %d, want 150", got)
+	}
+
+	encoded, err := json.Marshal(struct {
+		Wifi   uint16 `json:"balancer-tolerance-wifi"`
+		Mobile uint16 `json:"balancer-tolerance-mobile"`
+	}{150, 50})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var decoded URLTestOptions
+	if err := json.Unmarshal(encoded, &decoded); err != nil {
+		t.Fatal(err)
+	}
+	if decoded.BalancerToleranceWifi != 150 || decoded.BalancerToleranceMobile != 50 {
+		t.Fatalf("network tolerance JSON not retained: Wi-Fi=%d LTE=%d", decoded.BalancerToleranceWifi, decoded.BalancerToleranceMobile)
+	}
+}
