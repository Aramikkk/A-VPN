+package hcore
+
+import (
+	"context"
+	"github.com/stretchr/testify/require"
+	"testing"
+)
+
+func TestRebuildCannotStartStoppedCore(t *testing.T) {
+	static.CoreState = CoreStates_STOPPED
+	response, err := RebuildService(context.Background(), &StartRequest{ConfigContent: `{"outbounds":[]}`})
+	require.Error(t, err)
+	require.Contains(t, err.Error(), "core is STOPPED")
+	require.Equal(t, CoreStates_STOPPED, response.CoreState)
+	require.Equal(t, CoreStates_STOPPED, static.CoreState)
+	require.Nil(t, static.StartedService)
+}
+
+func TestHotReloadRunningCannotStartStoppedCore(t *testing.T) {
+	static.CoreState = CoreStates_STOPPED
+	_, err := HotReloadRunning(context.Background(), &StartRequest{})
+	require.ErrorContains(t, err, "core is STOPPED")
+	require.Equal(t, CoreStates_STOPPED, static.CoreState)
+}
