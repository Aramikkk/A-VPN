 	options.DNS = &option.DNSOptions{}
 	applyAdBlock(options, &HiddifyOptions{AdBlock: true, AdBlockAllow: []string{"https://Allowed.example/x", "bad", "allowed.example"}})
-	if len(options.Route.RuleSet) != len(adBlockLists) {
