-// ad domain list behind it, and a list of malware domains
-var adBlockLists = []struct{ tag, url string }{
-	{"adblock-hiddify", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-category-ads-all.srs"},
-	{"adblock-sagernet", adBlockBase + "SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"},
-	{"adblock-meta", adBlockBase + "MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs"},
-	{"adblock-malware", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-malware.srs"},
+// the lists, in sections. Ads, by strictness: Hiddify's large one (it carries the adblock filters' domains), then
+// a mirror of the community's ad domain list, then another mirror (the more lists, the more it refuses, and the
+// more sites that lean on an ad host break). Protection: malware and phishing domains. Miners: cryptominers.
+type adBlockList struct{ tag, url string }
+
+var (
+	adListsMild   = []adBlockList{{"adblock-hiddify", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-category-ads-all.srs"}}
+	adListsNormal = []adBlockList{{"adblock-sagernet", adBlockBase + "SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"}}
+	adListsStrict = []adBlockList{{"adblock-meta", adBlockBase + "MetaCubeX/meta-rules-dat/sing/geo/geosite/category-ads-all.srs"}}
+	protectLists  = []adBlockList{
+		{"adblock-malware", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-malware.srs"},
+		{"adblock-phishing", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-phishing.srs"},
+	}
+	minerLists = []adBlockList{{"adblock-miners", adBlockBase + "hiddify/hiddify-geo/rule-set/block/geosite-cryptominers.srs"}}
+)
+
+// adBlockSelected: the lists the options ask for.
+func adBlockSelected(hopt *HiddifyOptions) []adBlockList {
+	var lists []adBlockList
+	if hopt.AdBlock {
+		lists = append(lists, adListsMild...)
+		if hopt.AdBlockLevel != 1 {
+			lists = append(lists, adListsNormal...)
+		}
+		if hopt.AdBlockLevel >= 3 {
+			lists = append(lists, adListsStrict...)
+		}
+	}
+	if hopt.BlockPhishing {
+		lists = append(lists, protectLists...)
+	}
+	if hopt.BlockMiners {
+		lists = append(lists, minerLists...)
+	}
+	return lists
 }
 
 // adBlockDomain turns what the user typed ("https://www.Example.com/page", "*.example.com") into a domain.
@@ -49,7 +77,8 @@ func adBlockDomain(s string) string {
 
 // applyAdBlock adds the lists, the refusals and the exceptions when the option is on.
 func applyAdBlock(options *option.Options, hopt *HiddifyOptions) {
-	if !hopt.AdBlock || options.Route == nil {
+	selected := adBlockSelected(hopt)
+	if len(selected) == 0 || options.Route == nil {
 		return
 	}
 	var allow []string
@@ -60,8 +89,8 @@ func applyAdBlock(options *option.Options, hopt *HiddifyOptions) {
 			allow = append(allow, d)
 		}
 	}
