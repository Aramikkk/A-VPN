 }
+
+// The sections and the strictness pick the lists.
+func TestAdBlockSelectedLists(t *testing.T) {
+	count := func(h HiddifyOptions) int { return len(adBlockSelected(&h)) }
+	if count(HiddifyOptions{}) != 0 {
+		t.Fatal("nothing asked, nothing loaded")
+	}
+	mild := count(HiddifyOptions{AdBlock: true, AdBlockLevel: 1})
+	normal := count(HiddifyOptions{AdBlock: true})
+	strict := count(HiddifyOptions{AdBlock: true, AdBlockLevel: 3})
+	if !(mild < normal && normal < strict) {
+		t.Fatalf("mild %d, normal %d, strict %d: each must hold more", mild, normal, strict)
+	}
+	if count(HiddifyOptions{BlockPhishing: true}) != len(protectLists) || count(HiddifyOptions{BlockMiners: true}) != len(minerLists) {
+		t.Fatal("protection and miners are lists of their own, without the ads")
+	}
+	seen := map[string]bool{}
+	for _, l := range adBlockSelected(&HiddifyOptions{AdBlock: true, AdBlockLevel: 3, BlockPhishing: true, BlockMiners: true}) {
+		if seen[l.tag] {
+			t.Fatalf("tag %s twice", l.tag)
+		}
+		seen[l.tag] = true
+	}
+}
+
+func TestAdBlockProtectionAloneBuildsAndChecks(t *testing.T) {
+	profile := `{"outbounds": [
+  {"type": "socks", "tag": "pl", "server": "127.0.0.1", "server_port": 1080}]}`
+	hopts := DefaultHiddifyOptions()
+	hopts.BlockPhishing = true
+	options, err := BuildConfig(libbox.BaseContext(nil), hopts, &ReadOptions{Content: profile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if err := libbox.CheckConfigOptions(options); err != nil {
+		t.Fatalf("sing-box rejects the config: %v", err)
+	}
+}
