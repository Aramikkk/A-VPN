diff --git a/v2/config/ai_group.go b/v2/config/ai_group.go
new file mode 100644
index 0000000..7ff4ef8
--- /dev/null
+++ b/v2/config/ai_group.go
@@ -0,0 +1,121 @@
+package config
+
+import (
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json/badoption"
+)
+
+// H: the AI group: one group, one server, for every foreign AI service (ChatGPT, Claude, Gemini, Perplexity, DeepSeek).
+// The servers are the user's choice for the network the config is made for: the main one first, then the backups. The
+// group stays on the main one and goes to the next only when the one in use has failed, and back after the main one
+// has answered everything for ten minutes (a "pinned" group of sing-box). The AI services have no groups of their own
+// then (see applySiteGroups).
+
+// AIGroupTag is the tag of the AI group.
+const AIGroupTag = "ai"
+
+// aiServices are the site groups' keys of the AI services the AI group takes over.
+var aiServices = []string{"chatgpt", "claude", "gemini", "perplexity", "deepseek"}
+
+func isAIService(key string) bool {
+	for _, k := range aiServices {
+		if k == key {
+			return true
+		}
+	}
+	return false
+}
+
+// isAIPackage: [pkg] is the phone app of one of the AI services.
+func isAIPackage(pkg string) bool {
+	for _, site := range siteGroups {
+		if !isAIService(site.key) {
+			continue
+		}
+		for _, p := range site.packages {
+			if p == pkg {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func hasOutbound(options *option.Options, tag string) bool {
+	for _, out := range options.Outbounds {
+		if out.Tag == tag {
+			return true
+		}
+	}
+	return false
+}
+
+// applyAIGroup adds the AI group and the rules sending the AI services to it. It returns false (and changes nothing)
+// when no chosen server is among the config's outbounds.
+func applyAIGroup(options *option.Options, hopt *HiddifyOptions) bool {
+	if len(hopt.AIGroupServers) == 0 || options.Route == nil {
+		return false
+	}
+	servers := make([]string, 0, len(hopt.AIGroupServers))
+	seen := map[string]bool{}
+	for _, tag := range hopt.AIGroupServers {
+		if seen[tag] || !hasOutbound(options, tag) {
+			continue
+		}
+		seen[tag] = true
+		servers = append(servers, tag)
+	}
+	if len(servers) == 0 {
+		return false
+	}
+	var url string
+	var probes []string
+	rules := make([]option.Rule, 0, 2*len(aiServices))
+	seenProbe := map[string]bool{}
+	for _, site := range siteGroups {
+		if !isAIService(site.key) {
+			continue
+		}
+		if url == "" {
+			url = site.url
+		}
+		for _, probe := range site.probes {
+			if !seenProbe[probe] {
+				seenProbe[probe] = true
+				probes = append(probes, probe)
+			}
+		}
+		if len(site.packages) > 0 {
+			rules = append(rules, siteGroupRule(AIGroupTag, option.RawDefaultRule{PackageName: site.packages}))
+		}
+		rules = append(rules, siteGroupRule(AIGroupTag, option.RawDefaultRule{DomainSuffix: site.domainSuffix, IPCIDR: prefixables(site.ipCIDR)}))
+	}
+	group := option.Outbound{
+		Type: C.TypeURLTest,
+		Tag:  AIGroupTag,
+		Options: &option.URLTestOutboundOptions{
+			Outbounds: servers,
+			URL:       url,
+			URLs:      probes,
+			// a server is up when any probe answers: it has failed only when none does (one service blocked on a server is
+			// not a reason to leave it: the others work there)
+			StrictURLs: false,
+			// a test every ten seconds while the AI is in use (idle half an hour: no tests); three unanswered in a row
+			// is a failed server
+			Interval:      badoption.Duration(10 * time.Second),
+			IdleTimeout:   badoption.Duration(30 * time.Minute),
+			StableSamples: 3,
+			TestTimeout:   badoption.Duration(10 * time.Second),
+			// the servers in the order given; no warm-up: it would send the AI through the main choice
+			Pinned:       true,
+			PinnedReturn: badoption.Duration(10 * time.Minute),
+			// its own results; what is open on a server it leaves is closed by the group itself
+			PrivateHistory: true,
+		},
+	}
+	insertSiteOutbounds(options, []option.Outbound{group}, rules)
+	return true
+}
diff --git a/v2/config/ai_group_test.go b/v2/config/ai_group_test.go
new file mode 100644
index 0000000..0dfaea3
--- /dev/null
+++ b/v2/config/ai_group_test.go
@@ -0,0 +1,170 @@
+package config
+
+import (
+	"testing"
+	"time"
+
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/experimental/libbox"
+	"github.com/sagernet/sing-box/option"
+)
+
+func aiOptions(servers ...string) *HiddifyOptions {
+	return &HiddifyOptions{URLTestOptions: URLTestOptions{AIGroupServers: servers}}
+}
+
+func findAIGroup(options *option.Options) *option.URLTestOutboundOptions {
+	for _, out := range options.Outbounds {
+		if out.Tag == AIGroupTag {
+			return out.Options.(*option.URLTestOutboundOptions)
+		}
+	}
+	return nil
+}
+
+func ruleSuffixOutbound(options *option.Options, suffix string) string {
+	for _, rule := range options.Route.Rules {
+		for _, s := range rule.DefaultOptions.DomainSuffix {
+			if s == suffix {
+				return rule.DefaultOptions.RuleAction.RouteOptions.Outbound
+			}
+		}
+	}
+	return ""
+}
+
+func TestAIGroupOffChangesNothing(t *testing.T) {
+	options := siteGroupsTestOptions()
+	if applyAIGroup(options, aiOptions()) {
+		t.Fatal("no servers chosen: no group")
+	}
+	if len(options.Outbounds) != 7 || len(options.Route.Rules) != 4 {
+		t.Fatalf("off: %d outbounds, %d rules", len(options.Outbounds), len(options.Route.Rules))
+	}
+}
+
+func TestAIGroupIsPinnedToTheChosenServersInOrder(t *testing.T) {
+	options := siteGroupsTestOptions()
+	if !applyAIGroup(options, aiOptions("fi", "pl", "lv")) {
+		t.Fatal("three servers chosen: a group")
+	}
+	group := findAIGroup(options)
+	if group == nil {
+		t.Fatal("no group " + AIGroupTag)
+	}
+	if !group.Pinned || group.StrictURLs || len(group.URLs) < 2 || !group.PrivateHistory || group.InterruptExistConnections {
+		t.Fatalf("pinned, several probes and a server that answers any of them is up (only none answering is a failure), private expected: %+v", group)
+	}
+	if len(group.Outbounds) != 3 || group.Outbounds[0] != "fi" || group.Outbounds[1] != "pl" || group.Outbounds[2] != "lv" {
+		t.Fatalf("the chosen servers in the order given: %v", group.Outbounds)
+	}
+	if group.Interval.Build() != 10*time.Second || group.StableSamples != 3 || group.WarmUp.Build() != 0 || group.Candidates != 0 {
+		t.Fatalf("every 10 s, three samples, no warm-up (it would send the AI through the main choice): %+v", group)
+	}
+	if options.Outbounds[0].Tag != OutboundSelectTag || options.Outbounds[len(options.Outbounds)-1].Tag != OutboundDirectTag {
+		t.Fatal("the main group stays first, the direct outbound last")
+	}
+	for _, suffix := range []string{"claude.ai", "anthropic.com", "chatgpt.com", "openai.com", "gemini.google.com", "perplexity.ai", "deepseek.com"} {
+		if got := ruleSuffixOutbound(options, suffix); got != AIGroupTag {
+			t.Errorf("%s goes to %q, want %q", suffix, got, AIGroupTag)
+		}
+	}
+}
+
+func TestAIGroupSkipsServersThatAreNotThere(t *testing.T) {
+	options := siteGroupsTestOptions()
+	if !applyAIGroup(options, aiOptions("fi", "gone")) {
+		t.Fatal("one of two exists: a group")
+	}
+	if group := findAIGroup(options); len(group.Outbounds) != 1 || group.Outbounds[0] != "fi" {
+		t.Fatalf("only the server that exists: %v", group.Outbounds)
+	}
+	options = siteGroupsTestOptions()
+	if applyAIGroup(options, aiOptions("gone")) || findAIGroup(options) != nil {
+		t.Fatal("none exists: no group")
+	}
+}
+
+func TestSiteGroupsLeaveTheAIServicesToTheAIGroup(t *testing.T) {
+	options := siteGroupsTestOptions()
+	applyAIGroup(options, aiOptions("fi", "pl"))
+	applySiteGroups(options, &HiddifyOptions{URLTestOptions: URLTestOptions{SiteGroups: true, AIGroupServers: []string{"fi", "pl"}}})
+	for _, out := range options.Outbounds {
+		switch out.Tag {
+		case SiteGroupTagPrefix + "chatgpt", SiteGroupTagPrefix + "claude", SiteGroupTagPrefix + "gemini",
+			SiteGroupTagPrefix + "perplexity", SiteGroupTagPrefix + "deepseek":
+			t.Errorf("%s still has a group of its own", out.Tag)
+		}
+	}
+	found := false
+	for _, out := range options.Outbounds {
+		if out.Tag == SiteGroupTagPrefix+"youtube" && out.Type == C.TypeURLTest {
+			found = true
+		}
+	}
+	if !found {
+		t.Fatal("the other services keep their groups")
+	}
+	if got := ruleSuffixOutbound(options, "claude.ai"); got != AIGroupTag {
+		t.Fatalf("claude.ai goes to %q", got)
+	}
+}
+
+// The whole config built with the AI group on, as the app starts the core with it: sing-box takes it.
+func TestAIGroupBuiltConfigChecks(t *testing.T) {
+	profile := `{"outbounds": [
+  {"type": "socks", "tag": "🇩🇪 Германия", "server": "127.0.0.1", "server_port": 1080},
+  {"type": "socks", "tag": "🇫🇮 Финляндия", "server": "127.0.0.1", "server_port": 1081},
+  {"type": "socks", "tag": "🇸🇪 Швеция", "server": "127.0.0.1", "server_port": 1082}]}`
+	hopts := DefaultHiddifyOptions()
+	hopts.SiteGroups = true
+	hopts.AIGroupServers = []string{"🇫🇮 Финляндия", "🇩🇪 Германия"}
+	options, err := BuildConfig(libbox.BaseContext(nil), hopts, &ReadOptions{Content: profile})
+	if err != nil {
+		t.Fatalf("BuildConfig: %v", err)
+	}
+	if err := libbox.CheckConfigOptions(options); err != nil {
+		t.Fatalf("sing-box rejects the config: %v", err)
+	}
+	group := findAIGroup(options)
+	if group == nil || len(group.Outbounds) != 2 || group.Outbounds[0] != "🇫🇮 Финляндия" {
+		t.Fatalf("the AI group with the chosen servers in order: %+v", group)
+	}
+}
+
+// The AI apps the user marked in Settings → Sites have no group of their own once the AI group is on: their traffic
+// goes to the AI group, not to a group of the app's or to a service group that does not exist any more.
+func TestAIAppsGoToTheAIGroupWhateverTheAppsChoice(t *testing.T) {
+	options := siteGroupsTestOptions()
+	hopt := &HiddifyOptions{URLTestOptions: URLTestOptions{
+		SiteGroups:        true,
+		SiteGroupAppsOnly: true,
+		AIGroupServers:    []string{"fi", "pl"},
+		SiteGroupApps:     []string{"com.anthropic.claude", "com.openai.chatgpt", "ai.perplexity.app.android", "com.instagram.android"},
+	}}
+	applyAIGroup(options, hopt)
+	applySiteGroups(options, hopt)
+	outbounds := map[string]bool{}
+	for _, out := range options.Outbounds {
+		outbounds[out.Tag] = true
+	}
+	for _, rule := range options.Route.Rules {
+		target := rule.DefaultOptions.RuleAction.RouteOptions.Outbound
+		if target != "" && target != "block" && !outbounds[target] && target != OutboundDirectTag && target != OutboundSelectTag {
+			t.Errorf("a rule goes to %q, which does not exist", target)
+		}
+		for _, pkg := range rule.DefaultOptions.PackageName {
+			switch pkg {
+			case "com.anthropic.claude", "com.openai.chatgpt", "ai.perplexity.app.android":
+				if target != AIGroupTag {
+					t.Errorf("%s goes to %q, want %q", pkg, target, AIGroupTag)
+				}
+			}
+		}
+	}
+	for _, tag := range []string{AppGroupTagPrefix + "com.anthropic.claude", AppGroupTagPrefix + "ai.perplexity.app.android"} {
+		if outbounds[tag] {
+			t.Errorf("%s: an AI app has no group of its own when the AI group is on", tag)
+		}
+	}
+}
