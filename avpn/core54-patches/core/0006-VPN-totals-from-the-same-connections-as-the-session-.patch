From 31e436aa045449b23671745831e20d2dfdd3ecc4 Mon Sep 17 00:00:00 2001
From: Aram <154891765+Aramikkk@users.noreply.github.com>
Date: Mon, 12 Oct 2026 22:16:23 +0300
Subject: [PATCH 06/28] VPN totals from the same connections as the session
 total

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 v2/hcore/vpn_traffic.go | 25 +++++++++----------------
 1 file changed, 9 insertions(+), 16 deletions(-)

diff --git a/v2/hcore/vpn_traffic.go b/v2/hcore/vpn_traffic.go
index f1835a5..39c0baf 100644
--- a/v2/hcore/vpn_traffic.go
+++ b/v2/hcore/vpn_traffic.go
@@ -29,26 +29,19 @@ func isProviderServer(outboundType, tag string) bool {
 	return !strings.HasPrefix(tag, "🏠")
 }
 
-// vpnTraffic sums the traffic of every provider server of the running box.
+// vpnTraffic sums the session's traffic that went through the provider's servers, from the same connections the
+// session's total counts (so VPN + direct always equals the total, and a reload of the box doesn't skew the split).
 func (h *HiddifyInstance) vpnTraffic() (up, down int64) {
-	box, manager := h.Box(), h.TrafficManager()
-	if box == nil || manager == nil {
+	ins := h.Instance()
+	if ins == nil || ins.TrafficManager() == nil {
 		return 0, 0
 	}
-	add := func(outboundType, tag string) {
-		if !isProviderServer(outboundType, tag) {
-			return
+	ins.TrafficManager().OutboundTotals(func(outboundType, outbound string, u, d int64) {
+		if isProviderServer(outboundType, outbound) {
+			up += u
+			down += d
 		}
-		u, d := manager.OutboundUsage(tag)
-		up += u
-		down += d
-	}
-	for _, outbound := range box.Outbound().Outbounds() {
-		add(outbound.Type(), outbound.Tag())
-	}
-	for _, endpoint := range box.Endpoint().Endpoints() {
-		add(endpoint.Type(), endpoint.Tag())
-	}
+	})
 	return up, down
 }
 
