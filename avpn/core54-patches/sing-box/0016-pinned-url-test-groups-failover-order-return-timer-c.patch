+++ b/protocol/group/h_urltest_modes.go
@@ -133,6 +133,10 @@ func (g *URLTestGroup) penaltyBest(network string, exclude adapter.Outbound) ada
 // selectForUpdate is the selection of performUpdateCheck: failover keeps the selected member,
 // and penalties rank first when the fastest member has too many.
 func (g *URLTestGroup) selectForUpdate(network string) (adapter.Outbound, bool) {
+	// H: a pinned group (the AI services) goes by its own order and failure window only, not by the penalties
+	if g.pinned && g.stableSamples > 0 {
+		return g.selectPinned(network)
+	}
 	if g.penaltyEmergency(network) {
 		if best := g.penaltyBest(network, nil); best != nil {
 			return best, true
diff --git a/protocol/group/pinned.go b/protocol/group/pinned.go
index 3d9b7d033..9057a9b7e 100644
--- a/protocol/group/pinned.go
+++ b/protocol/group/pinned.go
@@ -1,6 +1,12 @@
 package group
 
-import "time"
+import (
+	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing/common"
+	N "github.com/sagernet/sing/common/network"
+)
 
 // H: pinnedChoice picks the server of a pinned group (the AI services: one server, chosen by the user, that must not
 // hop). [order] is the servers by the user's priority (the main one, then the backups), [current] the server in use,
@@ -40,3 +46,70 @@ func pinnedChoice(order []string, current string, down func(tag string) bool, pr
 	}
 	return current
 }
+
+// pinnedDown: a server of a pinned group has failed when it has the results of a whole window and none of them answered.
+func (g *URLTestGroup) pinnedDown(tag string) bool {
+	g.samplesAccess.Lock()
+	list := append([]uint16(nil), g.samples[tag]...)
+	g.samplesAccess.Unlock()
+	if len(list) < g.stableSamples || len(list) == 0 {
+		return false
+	}
+	for _, delay := range list {
+		if delay != 0 && delay != 65535 {
+			return false
+		}
+	}
+	return true
+}
+
+// notePrimary: the main server answered (or not) a test: the count of how long it has answered everything starts at
+// its first answer and starts again after a failed test.
+func (g *URLTestGroup) notePrimary(answered bool, now time.Time) {
+	if !answered {
+		g.primaryUp.Store(0)
+		return
+	}
+	g.primaryUp.CompareAndSwap(0, now.UnixNano())
+}
+
+// primaryUpFor: how long the main server has answered every test (0: it has not).
+func (g *URLTestGroup) primaryUpFor(now time.Time) time.Duration {
+	since := g.primaryUp.Load()
+	if since == 0 {
+		return 0
+	}
+	return now.Sub(time.Unix(0, since))
+}
+
+// selectPinned: the pinned group's choice for [network] among its servers in the order given.
+func (g *URLTestGroup) selectPinned(network string) (adapter.Outbound, bool) {
+	var order []adapter.Outbound
+	for _, detour := range g.outbounds {
+		if common.Contains(detour.Network(), network) {
+			order = append(order, detour)
+		}
+	}
+	if len(order) == 0 {
+		return nil, false
+	}
+	tags := make([]string, len(order))
+	for i, detour := range order {
+		tags[i] = detour.Tag()
+	}
+	current := g.selectedOutboundTCP
+	if network == N.NetworkUDP {
+		current = g.selectedOutboundUDP
+	}
+	currentTag := ""
+	if current != nil {
+		currentTag = current.Tag()
+	}
+	chosen := pinnedChoice(tags, currentTag, g.pinnedDown, g.primaryUpFor(time.Now()), g.pinnedReturn)
+	for _, detour := range order {
+		if detour.Tag() == chosen {
+			return detour, true
+		}
+	}
+	return order[0], true
+}
