index 3a591875c..6c6d1b838 100644
--- a/protocol/group/pinned_test.go
+++ b/protocol/group/pinned_test.go
@@ -3,6 +3,9 @@ package group
 import (
 	"testing"
 	"time"
+
+	"github.com/sagernet/sing-box/adapter"
+	N "github.com/sagernet/sing/common/network"
 )
 
 func TestPinnedChoice(t *testing.T) {
@@ -44,3 +47,97 @@ func TestPinnedChoice(t *testing.T) {
 		}
 	}
 }
+
+type fakeOut struct {
+	adapter.Outbound
+	tag string
+}
+
+func (f fakeOut) Tag() string       { return f.tag }
+func (f fakeOut) Network() []string { return []string{N.NetworkTCP, N.NetworkUDP} }
+
+func pinnedGroup(tags ...string) *URLTestGroup {
+	g := &URLTestGroup{stableSamples: 3, pinned: true, pinnedReturn: 10 * time.Minute, samples: map[string][]uint16{}}
+	for _, tag := range tags {
+		g.outbounds = append(g.outbounds, fakeOut{tag: tag})
+	}
+	return g
+}
+
+func TestPinnedDown(t *testing.T) {
+	g := pinnedGroup("a")
+	set := func(results ...uint16) { g.samples["a"] = results }
+	set()
+	if g.pinnedDown("a") {
+		t.Fatal("no results yet: not down")
+	}
+	set(0, 0)
+	if g.pinnedDown("a") {
+		t.Fatal("two failed tests are less than a whole window: not down")
+	}
+	set(120, 0, 0)
+	if g.pinnedDown("a") {
+		t.Fatal("one test of the window answered: not down")
+	}
+	set(0, 65535, 0)
+	if !g.pinnedDown("a") {
+		t.Fatal("a whole window unanswered: down")
+	}
+}
+
+func TestPrimaryReturnTimer(t *testing.T) {
+	g := pinnedGroup("a", "b")
+	now := time.Unix(1000, 0)
+	if g.primaryUpFor(now) != 0 {
+		t.Fatal("never answered: zero")
+	}
+	g.notePrimary(true, now)
+	g.notePrimary(true, now.Add(time.Minute))
+	if got := g.primaryUpFor(now.Add(4 * time.Minute)); got != 4*time.Minute {
+		t.Fatalf("counted from the first answer, got %v", got)
+	}
+	g.notePrimary(false, now.Add(5*time.Minute))
+	if g.primaryUpFor(now.Add(6*time.Minute)) != 0 {
+		t.Fatal("one failed test starts the count again")
+	}
+}
+
+func TestSelectPinned(t *testing.T) {
+	g := pinnedGroup("a", "b", "c")
+	pick := func() string {
+		out, ok := g.selectPinned(N.NetworkTCP)
+		if !ok || out == nil {
+			t.Fatal("a pinned group always has a choice")
+		}
+		return out.Tag()
+	}
+	if got := pick(); got != "a" {
+		t.Fatalf("before any test: the main server, got %s", got)
+	}
+	g.selectedOutboundTCP = g.outbounds[0]
+	g.samples["a"] = []uint16{0, 0, 0}
+	if got := pick(); got != "b" {
+		t.Fatalf("main failed: the first backup, got %s", got)
+	}
+	g.selectedOutboundTCP = g.outbounds[1]
+	g.samples["b"] = []uint16{0, 0, 0}
+	if got := pick(); got != "c" {
+		t.Fatalf("the first backup failed too: the second, got %s", got)
+	}
+	g.selectedOutboundTCP = g.outbounds[2]
+	g.samples["c"] = []uint16{0, 0, 0}
+	if got := pick(); got != "c" {
+		t.Fatalf("all failed: stays, got %s", got)
+	}
+	g.selectedOutboundTCP = g.outbounds[1]
+	g.samples["a"] = []uint16{50, 50, 50}
+	g.samples["b"] = []uint16{50, 50, 50}
+	g.primaryUp.Store(time.Now().Add(-9 * time.Minute).UnixNano())
+	if got := pick(); got != "b" {
+		t.Fatalf("main back for nine minutes: stays on the backup, got %s", got)
+	}
+	g.primaryUp.Store(time.Now().Add(-11 * time.Minute).UnixNano())
+	if got := pick(); got != "a" {
+		t.Fatalf("main stable for ten minutes: back to it, got %s", got)
+	}
+}
