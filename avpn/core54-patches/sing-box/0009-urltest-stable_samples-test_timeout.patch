From 66636c351404acedd1cc30b347ad1855af16ffcf Mon Sep 17 00:00:00 2001
From: Aram <154891765+Aramikkk@users.noreply.github.com>
Date: Tue, 20 Oct 2026 22:53:28 +0300
Subject: [PATCH 09/14] urltest: stable_samples, test_timeout

With stable_samples a server counts only after answering that many tests in a
row, chosen by their average; until one has, the group goes through its warm-up
detour instead of the first server listed. The warm-up runs that many rounds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 option/group.go                   |   5 +
 protocol/group/h_urltest_modes.go | 822 +++++++++++++++---------------
 protocol/group/urltest.go         | 169 +++++-
 protocol/group/urltest_test.go    |  55 ++
 4 files changed, 627 insertions(+), 424 deletions(-)

diff --git a/option/group.go b/option/group.go
index f294de5cb..367be6799 100644
--- a/option/group.go
+++ b/option/group.go
@@ -24,4 +24,9 @@ type URLTestOutboundOptions struct {
 	// WarmUpDetour (the servers' pings and the main choice aren't settled yet), its own tests already running
 	WarmUp       badoption.Duration `json:"warm_up,omitempty"`
 	WarmUpDetour string             `json:"warm_up_detour,omitempty"`
+	// H: a server is taken only after this many tests in a row answered, by their average; until one has,
+	// everything goes through WarmUpDetour (not through the first server listed)
+	StableSamples int `json:"stable_samples,omitempty"`
+	// H: how long one test may take (0: the TCP timeout, 5 s)
+	TestTimeout badoption.Duration `json:"test_timeout,omitempty"`
 }
