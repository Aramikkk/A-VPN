@@ -0,0 +1,42 @@
+package group
+
+import "time"
+
+// H: pinnedChoice picks the server of a pinned group (the AI services: one server, chosen by the user, that must not
+// hop). [order] is the servers by the user's priority (the main one, then the backups), [current] the server in use,
+// [down] says a server has failed (a whole window of tests unanswered). The group leaves the server in use only when it
+// is down, then takes the first one in the order that is not; from a backup it goes back to the main one only after the
+// main one has answered everything for [returnAfter] ([primaryUpFor] is how long it has). When every server is down it
+// stays where it is.
+func pinnedChoice(order []string, current string, down func(tag string) bool, primaryUpFor, returnAfter time.Duration) string {
+	if len(order) == 0 {
+		return current
+	}
+	first := ""
+	for _, tag := range order {
+		if !down(tag) {
+			first = tag
+			break
+		}
+	}
+	if first == "" {
+		if current != "" {
+			return current
+		}
+		return order[0]
+	}
+	inOrder := false
+	for _, tag := range order {
+		if tag == current {
+			inOrder = true
+			break
+		}
+	}
+	if current == "" || !inOrder || down(current) {
+		return first
+	}
+	if current != order[0] && !down(order[0]) && primaryUpFor >= returnAfter {
+		return order[0]
+	}
+	return current
+}
diff --git a/protocol/group/pinned_test.go b/protocol/group/pinned_test.go
new file mode 100644
index 000000000..3a591875c
--- /dev/null
+++ b/protocol/group/pinned_test.go
@@ -0,0 +1,46 @@
+package group
+
+import (
+	"testing"
+	"time"
+)
+
+func TestPinnedChoice(t *testing.T) {
+	order := []string{"a", "b", "c"}
+	downSet := func(tags ...string) func(string) bool {
+		return func(tag string) bool {
+			for _, d := range tags {
+				if d == tag {
+					return true
+				}
+			}
+			return false
+		}
+	}
+	const ret = 10 * time.Minute
+	cases := []struct {
+		name    string
+		current string
+		down    []string
+		upFor   time.Duration
+		want    string
+	}{
+		{"nothing chosen yet: the first that answers", "", nil, 0, "a"},
+		{"nothing chosen yet, primary down", "", []string{"a"}, 0, "b"},
+		{"primary in use and up: stays", "a", nil, 0, "a"},
+		{"primary down: the first backup", "a", []string{"a"}, 0, "b"},
+		{"primary and the first backup down: the second", "a", []string{"a", "b"}, 0, "c"},
+		{"all down: stays where it is", "c", []string{"a", "b", "c"}, 0, "c"},
+		{"on a backup, primary up nine minutes: stays", "b", nil, 9 * time.Minute, "b"},
+		{"on a backup, primary up ten minutes: back to primary", "b", nil, 10 * time.Minute, "a"},
+		{"on a backup that is down, primary up: primary at once", "b", []string{"b"}, 0, "a"},
+		{"on the second backup, the first up and primary still down: stays", "c", []string{"a"}, 0, "c"},
+		{"on the second backup that is down, primary down, first backup up", "c", []string{"a", "c"}, 0, "b"},
+	}
+	for _, c := range cases {
+		got := pinnedChoice(order, c.current, downSet(c.down...), c.upFor, ret)
+		if got != c.want {
+			t.Errorf("%s: got %q, want %q", c.name, got, c.want)
+		}
+	}
+}
