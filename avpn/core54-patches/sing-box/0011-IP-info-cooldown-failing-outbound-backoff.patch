diff --git a/hiddify/ipinfo/cooldown.go b/hiddify/ipinfo/cooldown.go
new file mode 100644
index 000000000..a59bffbda
--- /dev/null
+++ b/hiddify/ipinfo/cooldown.go
@@ -0,0 +1,72 @@
+package ipinfo
+
+import (
+	"strings"
+	"sync"
+	"time"
+)
+
+// A provider that keeps failing (a rate limit, a block, a host that doesn't answer) is left alone for a while
+// instead of being tried again for every outbound on every round: the free IP services answered 429 and 403
+// thousands of times an hour. Three failures in a row put a provider aside for a minute, doubling up to a
+// quarter of an hour; a refusal by status (a limit or a block) puts it aside for ten minutes at once. One answer
+// clears it.
+const (
+	cooldownAfter    = 3
+	cooldownFirst    = time.Minute
+	cooldownMax      = 15 * time.Minute
+	cooldownByStatus = 10 * time.Minute
+)
+
+type providerState struct {
+	streak int
+	until  time.Time
+}
+
+type cooldowns struct {
+	mu sync.Mutex
+	by map[string]*providerState
+}
+
+var providerCooldowns = &cooldowns{by: map[string]*providerState{}}
+
+// ready: the provider isn't set aside at now.
+func (c *cooldowns) ready(name string, now time.Time) bool {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s := c.by[name]
+	return s == nil || !now.Before(s.until)
+}
+
+// failed notes a failure and says whether the provider was just put aside (and for how long).
+func (c *cooldowns) failed(name string, err error, now time.Time) (time.Duration, bool) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	s := c.by[name]
+	if s == nil {
+		s = &providerState{}
+		c.by[name] = s
+	}
+	s.streak++
+	var wait time.Duration
+	switch {
+	case err != nil && strings.Contains(err.Error(), "non-200 response"):
+		wait = cooldownByStatus
+	case s.streak >= cooldownAfter:
+		wait = cooldownFirst << (s.streak - cooldownAfter)
+		if wait > cooldownMax || wait <= 0 {
+			wait = cooldownMax
+		}
+	}
+	if wait == 0 {
+		return 0, false
+	}
+	s.until = now.Add(wait)
+	return wait, true
+}
+
+func (c *cooldowns) ok(name string) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	delete(c.by, name)
+}
diff --git a/hiddify/ipinfo/cooldown_test.go b/hiddify/ipinfo/cooldown_test.go
new file mode 100644
index 000000000..1ec7a91f3
--- /dev/null
+++ b/hiddify/ipinfo/cooldown_test.go
@@ -0,0 +1,57 @@
+package ipinfo
+
+import (
+	"errors"
+	"testing"
+	"time"
+)
+
+func TestCooldownAfterFailures(t *testing.T) {
+	c := &cooldowns{by: map[string]*providerState{}}
+	now := time.Now()
+	timeout := errors.New("context deadline exceeded")
+	for i := 0; i < 2; i++ {
+		if _, aside := c.failed("p", timeout, now); aside {
+			t.Fatalf("failure %d should not put the provider aside", i+1)
+		}
+		if !c.ready("p", now) {
+			t.Fatal("still ready after fewer than three failures")
+		}
+	}
+	wait, aside := c.failed("p", timeout, now)
+	if !aside || wait != time.Minute {
+		t.Fatalf("third failure: aside=%v wait=%v", aside, wait)
+	}
+	if c.ready("p", now.Add(30*time.Second)) || !c.ready("p", now.Add(61*time.Second)) {
+		t.Fatal("aside for a minute")
+	}
+	wait, _ = c.failed("p", timeout, now.Add(2*time.Minute))
+	if wait != 2*time.Minute {
+		t.Fatalf("doubles: %v", wait)
+	}
+	c.ok("p")
+	if !c.ready("p", now) {
+		t.Fatal("an answer clears it")
+	}
+}
+
+func TestCooldownByStatusAtOnce(t *testing.T) {
+	c := &cooldowns{by: map[string]*providerState{}}
+	now := time.Now()
+	wait, aside := c.failed("p", errors.New("non-200 response from [x]: 429"), now)
+	if !aside || wait != cooldownByStatus || c.ready("p", now.Add(5*time.Minute)) {
+		t.Fatalf("a refusal by status: aside=%v wait=%v", aside, wait)
+	}
+}
+
+func TestCooldownCap(t *testing.T) {
+	c := &cooldowns{by: map[string]*providerState{}}
+	now := time.Now()
+	var wait time.Duration
+	for i := 0; i < 80; i++ {
+		wait, _ = c.failed("p", errors.New("timeout"), now)
+	}
+	if wait != cooldownMax {
+		t.Fatalf("capped: %v", wait)
+	}
+}
