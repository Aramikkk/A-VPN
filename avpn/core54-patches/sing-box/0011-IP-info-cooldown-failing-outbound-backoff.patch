diff --git a/common/monitoring/fail_backoff.go b/common/monitoring/fail_backoff.go
new file mode 100644
index 000000000..f9e95de74
--- /dev/null
+++ b/common/monitoring/fail_backoff.go
@@ -0,0 +1,60 @@
+package monitoring
+
+import (
+	"sync"
+	"time"
+)
+
+// An outbound whose URL test failed again and again (a server that is down, or one whose settings are wrong) is
+// tested less often by the regular rounds: five failures in a row, then it waits two minutes, doubling up to
+// twenty. A test asked for by hand, and one answer, set it right at once.
+const (
+	failBackoffAfter = 5
+	failBackoffFirst = 2 * time.Minute
+	failBackoffMax   = 20 * time.Minute
+)
+
+type failEntry struct {
+	streak int
+	until  time.Time
+}
+
+type failBackoff struct {
+	mu sync.Mutex
+	by map[string]*failEntry
+}
+
+func (b *failBackoff) skip(tag string, now time.Time) bool {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	e := b.by[tag]
+	return e != nil && now.Before(e.until)
+}
+
+func (b *failBackoff) failed(tag string, now time.Time) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	if b.by == nil {
+		b.by = map[string]*failEntry{}
+	}
+	e := b.by[tag]
+	if e == nil {
+		e = &failEntry{}
+		b.by[tag] = e
+	}
+	e.streak++
+	if e.streak < failBackoffAfter {
+		return
+	}
+	wait := failBackoffFirst << (e.streak - failBackoffAfter)
+	if wait > failBackoffMax || wait <= 0 {
+		wait = failBackoffMax
+	}
+	e.until = now.Add(wait)
+}
+
+func (b *failBackoff) ok(tag string) {
+	b.mu.Lock()
+	defer b.mu.Unlock()
+	delete(b.by, tag)
+}
diff --git a/common/monitoring/fail_backoff_test.go b/common/monitoring/fail_backoff_test.go
new file mode 100644
index 000000000..5b402aeb4
--- /dev/null
+++ b/common/monitoring/fail_backoff_test.go
@@ -0,0 +1,32 @@
+package monitoring
+
+import (
+	"testing"
+	"time"
+)
+
+func TestFailBackoff(t *testing.T) {
+	var b failBackoff
+	now := time.Now()
+	for i := 0; i < failBackoffAfter-1; i++ {
+		b.failed("s", now)
+		if b.skip("s", now) {
+			t.Fatalf("skipped after %d failures", i+1)
+		}
+	}
+	b.failed("s", now)
+	if !b.skip("s", now.Add(time.Minute)) || b.skip("s", now.Add(3*time.Minute)) {
+		t.Fatal("waits two minutes after the fifth failure")
+	}
+	b.failed("s", now.Add(3*time.Minute))
+	if !b.skip("s", now.Add(6*time.Minute)) || b.skip("s", now.Add(8*time.Minute)) {
+		t.Fatal("waits four minutes after the sixth")
+	}
+	b.ok("s")
+	if b.skip("s", now) {
+		t.Fatal("an answer clears it")
+	}
+	if b.skip("other", now) {
+		t.Fatal("others unaffected")
+	}
+}
