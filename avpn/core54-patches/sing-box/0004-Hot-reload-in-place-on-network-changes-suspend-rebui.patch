+package group
+
+import (
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/common/urltest"
+	N "github.com/sagernet/sing/common/network"
+	"testing"
+	"time"
+)
+
+type selectionOutbound struct {
+	adapter.Outbound
+	tag string
+}
+
+func (o *selectionOutbound) Tag() string       { return o.tag }
+func (o *selectionOutbound) Network() []string { return []string{N.NetworkTCP, N.NetworkUDP} }
+
+func TestURLTestSelectionStability(t *testing.T) {
+	for _, network := range []string{N.NetworkTCP, N.NetworkUDP} {
+		for _, tc := range []struct {
+			name               string
+			current, candidate uint16
+			wantCandidate      bool
+		}{
+			{"ten milliseconds faster", 200, 190, false},
+			{"twenty milliseconds faster", 200, 180, false},
+			{"at tolerance", 300, 150, false},
+			{"beyond tolerance", 301, 150, true},
+			{"failed candidate", 200, 65535, false},
+			{"unknown candidate", 200, 0, false},
+			{"failed current", 65535, 65400, true},
+			{"unknown current", 0, 200, true},
+			{"large valid candidate", 65450, 65400, false},
+		} {
+			t.Run(network+"/"+tc.name, func(t *testing.T) {
+				current := &selectionOutbound{tag: "current"}
+				candidate := &selectionOutbound{tag: "candidate"}
+				history := urltest.NewHistoryStorage()
+				history.StoreURLTestHistory(current.Tag(), &adapter.URLTestHistory{Delay: tc.current, Time: time.Now()})
+				history.StoreURLTestHistory(candidate.Tag(), &adapter.URLTestHistory{Delay: tc.candidate, Time: time.Now()})
+				group := &URLTestGroup{outbounds: []adapter.Outbound{current, candidate}, history: history, tolerance: 150, selectedOutboundTCP: current, selectedOutboundUDP: current}
+				got, available := group.Select(network)
+				want := current
+				if tc.wantCandidate {
+					want = candidate
+				}
+				if got != want || !available {
+					t.Fatalf("selected %v available=%v; want %s available=true", got.Tag(), available, want.Tag())
+				}
+			})
+		}
+	}
+}
