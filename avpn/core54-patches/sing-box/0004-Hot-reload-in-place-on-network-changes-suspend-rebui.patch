+func TestH_BalancerLowestDelayMobileTolerance(t *testing.T) {
+	for _, tc := range []struct {
+		name                           string
+		current, candidate             uint16
+		cachedCurrent, cachedCandidate bool
+		want                           string
+	}{
+		{"ten milliseconds", 200, 190, false, false, "current"},
+		{"twenty milliseconds", 200, 180, false, false, "current"},
+		{"at tolerance", 300, 150, false, false, "current"},
+		{"beyond tolerance", 301, 150, false, false, "candidate"},
+		{"dead current", 65535, 200, false, false, "candidate"},
+		{"dead candidate", 200, 65535, false, false, "current"},
+		{"cached challenger", 200, 180, false, true, "current"},
+		{"fresh challenger waits for cached current", 200, 180, true, false, "current"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			current, candidate := newFake("current"), newFake("candidate")
+			strategy := NewLowestDelay(outs(current, candidate), option.BalancerOutboundOptions{Tolerance: 150})
+			history := map[string]*adapter.URLTestHistory{
+				"current":   {Delay: tc.current, IsFromCache: tc.cachedCurrent},
+				"candidate": {Delay: tc.candidate, IsFromCache: tc.cachedCandidate},
+			}
+			strategy.UpdateOutboundsInfo(history)
+			require.Equal(t, tc.want, strategy.Now())
+			for _, network := range []string{N.NetworkTCP, N.NetworkUDP} {
+				require.Equal(t, tc.want, strategy.Select(adapter.InboundContext{}, network, false).Tag())
+			}
+		})
+	}
+}
