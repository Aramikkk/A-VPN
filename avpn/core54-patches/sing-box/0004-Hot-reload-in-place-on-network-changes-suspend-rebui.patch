 	if !plan.result.IsEmpty() {
+		selections := make(map[string]string)
+		for _, outbound := range s.outbound.Outbounds() {
+			if selector, ok := outbound.(hotReloadSelector); ok {
+				if selected := selector.Selected(N.NetworkTCP); selected != nil {
+					selections[outbound.Tag()] = selected.Tag()
+				}
+			}
+		}
 		if err = s.applyHotReload(ctx, plan); err != nil {
+			// A resource can fail after earlier managers were already updated.
+			// Reapply the inverse diff, rather than leaving runtime and runningOptions divergent.
+			rollback, rollbackErr := planHotReload(s.ctx, *options, s.runningOptions)
+			if rollbackErr == nil {
+				recoveryCtx, cancel := context.WithTimeout(s.ctx, C.StartTimeout)
+				rollbackErr = s.applyHotReload(recoveryCtx, rollback)
+				cancel()
+			}
+			if rollbackErr != nil {
+				return plan.result, E.Cause(errors.Join(err, rollbackErr), "hot reload and rollback failed")
+			}
+			for tag, selected := range selections {
+				if outbound, loaded := s.outbound.Outbound(tag); loaded {
+					if selector, ok := outbound.(hotReloadSelector); ok {
+						selector.SelectOutbound(selected)
+					}
+				}
+			}
