+func TestH_HotReloadRuleSetFailureKeepsLiveOutbounds(t *testing.T) {
+	instance, ctx, _ := hStartReloadBox(t)
+	keep := hOutbound(t, instance, "keep")
+	selector := hOutbound(t, instance, "select").(interface{ SelectOutbound(string) bool })
+	require.True(t, selector.SelectOutbound("b"))
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusServiceUnavailable)
+	}))
+	defer server.Close()
+	content := strings.Replace(hReloadBase, `"type": "direct", "tag": "b"`, `"type": "block", "tag": "b"`, 1)
+	content = strings.Replace(content, `"route": {"final": "select"}`, `"route": {"final": "select", "rule_set": [{"type": "remote", "tag": "unavailable", "format": "source", "url": "`+server.URL+`", "download_detour": "a", "http_client": {"detour": "a"}}]}`, 1)
+	options := hParseOptions(t, ctx, content)
+	reloadCtx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	_, err := instance.HotReloadWithResult(reloadCtx, &options)
+	require.Error(t, err)
+	require.Equal(t, "direct", hOutbound(t, instance, "b").Type(), "failed rule-set startup must restore the previous outbound configuration")
+	require.Same(t, keep, hOutbound(t, instance, "keep"), "rollback must leave unchanged outbounds running")
+	require.Equal(t, "b", hOutbound(t, instance, "select").(adapter.OutboundGroup).Selected(N.NetworkTCP).Tag(), "rollback must restore the user's selection")
+}
+
+func TestH_HotReloadDNSFailureRollsBackOutbounds(t *testing.T) {
+	instance, ctx, _ := hStartReloadBox(t)
+	content := strings.Replace(hReloadBase, `"type": "direct", "tag": "b"`, `"type": "block", "tag": "b"`, 1)
+	content = strings.Replace(content, `"route": {"final": "select"}`, `"dns": {"servers": [{"type": "fakeip", "tag": "invalid-fakeip"}]}, "route": {"final": "select"}`, 1)
+	options := hParseOptions(t, ctx, content)
+	_, err := instance.HotReloadWithResult(context.Background(), &options)
+	require.Error(t, err)
+	require.NotContains(t, err.Error(), "rollback failed")
+	require.Equal(t, "direct", hOutbound(t, instance, "b").Type())
+}
