+// keepCurrent reports whether current is still good enough next to best: it answers, and best isn't faster by
+// more than the tolerance. A tolerance of 0 or 1 keeps the old behaviour of always taking the fastest.
+func (s *LowestDelay) keepCurrent(current, best adapter.Outbound, history map[string]*adapter.URLTestHistory) bool {
+	if s.tolerance <= 1 {
+		return false
+	}
+	// a server with few results behind it is no steady choice yet: the one that answered first (or luckily) must not
