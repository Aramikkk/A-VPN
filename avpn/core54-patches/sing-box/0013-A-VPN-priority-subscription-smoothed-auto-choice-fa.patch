+
+// A-VPN: the priority subscription's server wins unless another is faster by more than the margin; when it
+// doesn't answer, another takes over at once.
+func TestH_BalancerLowestDelayPriority(t *testing.T) {
+	p, o := newFake("p"), newFake("o")
+	s := NewLowestDelay(outs(o, p), option.BalancerOutboundOptions{PriorityOutbounds: []string{"p"}, PriorityMargin: 100})
+
+	// o is faster by 60 ms: less than the margin, p stays
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"p": his(160), "o": his(100)})
+	require.Equal(t, "p", s.Now())
+
+	// o is faster by 150 ms: more than the margin, o takes over
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"p": his(300), "o": his(150)})
+	require.Equal(t, "o", s.Now())
+
+	// p answers well again
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"p": his(130), "o": his(100)})
+	require.Equal(t, "p", s.Now())
+
+	// p does not answer: o at once
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"p": his(monitoring.TimeoutDelay), "o": his(900)})
+	require.Equal(t, "o", s.Now())
+
+	// no priority: the plain fastest
+	plain := NewLowestDelay(outs(o, p), option.BalancerOutboundOptions{})
+	plain.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"p": his(160), "o": his(100)})
+	require.Equal(t, "o", plain.Now())
+}
+
+// A-VPN: a server's lucky first answer doesn't hold the place; the choice goes by the last results, and a server
+// that drops out now and then loses to a steady one.
+func TestH_BalancerLowestDelaySmoothed(t *testing.T) {
+	pl, ee := newFake("pl"), newFake("ee")
+	s := NewLowestDelay(outs(ee, pl), option.BalancerOutboundOptions{Tolerance: 150, SmoothSamples: 3})
+	at := time.Now()
+	round := func(plDelay, eeDelay uint16) {
+		at = at.Add(10 * time.Second)
+		s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{
+			"pl": {Delay: plDelay, Time: at},
+			"ee": {Delay: eeDelay, Time: at},
+		})
+	}
+	// ee answers first with a lucky 40 ms, pl 90: ee in front for now (both have one result)
+	round(90, 40)
+	require.Equal(t, "ee", s.Now())
+	// ee then fails once, pl is steady: pl, although tolerance would have kept ee if it were settled
+	round(90, monitoring.TimeoutDelay)
+	require.Equal(t, "pl", s.Now())
+	round(95, 60)
+	require.Equal(t, "pl", s.Now())
+	// the single-result ranking is kept out of it: no tolerance holds an unsettled server
+	fresh := NewLowestDelay(outs(ee, pl), option.BalancerOutboundOptions{Tolerance: 150, SmoothSamples: 3})
+	fresh.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"ee": {Delay: 50, Time: at}, "pl": {Delay: 80, Time: at}})
+	require.Equal(t, "ee", fresh.Now())
+	at = at.Add(10 * time.Second)
+	fresh.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"ee": {Delay: 300, Time: at}, "pl": {Delay: 80, Time: at}})
+	require.Equal(t, "pl", fresh.Now())
+}
+
+// A-VPN: a move of the choice is told with the delays it went by.
+func TestH_BalancerLowestDelayTellsSwitch(t *testing.T) {
+	a, b := newFake("a"), newFake("b")
+	s := NewLowestDelay(outs(a, b), option.BalancerOutboundOptions{PriorityOutbounds: []string{"a"}, PriorityMargin: 10})
+	var told []string
+	s.SetOnSwitch(func(from, to, detail string) { told = append(told, from+">"+to+": "+detail) })
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"a": his(50), "b": his(200)})
+	require.Empty(t, told, "the first choice is no move")
+	s.UpdateOutboundsInfo(map[string]*adapter.URLTestHistory{"a": his(400), "b": his(90)})
+	require.Len(t, told, 1)
+	require.Contains(t, told[0], "a>b")
+	require.Contains(t, told[0], "priority")
+}
