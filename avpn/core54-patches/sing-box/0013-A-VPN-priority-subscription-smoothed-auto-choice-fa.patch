diff --git a/common/failwatch/failwatch.go b/common/failwatch/failwatch.go
new file mode 100644
index 000000000..975aed3fd
--- /dev/null
+++ b/common/failwatch/failwatch.go
@@ -0,0 +1,68 @@
+// Package failwatch tells a group that the server it uses stops letting connections through: several dials in a
+// row failing on it, with none succeeding between. It costs nothing while connections work.
+package failwatch
+
+import (
+	"sync"
+	"time"
+)
+
+type Watch struct {
+	mu sync.Mutex
+	// how many failures in a row, within how long, make [Failed] true; and how long it stays quiet after that
+	threshold int
+	window    time.Duration
+	cooldown  time.Duration
+	servers   map[string]*record
+	now       func() time.Time
+}
+
+type record struct {
+	failures  []time.Time
+	triggered time.Time
+}
+
+// New is a watch that reports after three failures in twenty seconds, and not again for thirty.
+func New() *Watch {
+	return &Watch{threshold: 3, window: 20 * time.Second, cooldown: 30 * time.Second, servers: map[string]*record{}, now: time.Now}
+}
+
+// Failed notes one failed dial through the server tag and reports whether the group should test its servers now.
+func (w *Watch) Failed(tag string) bool {
+	if w == nil {
+		return false
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	now := w.now()
+	r := w.servers[tag]
+	if r == nil {
+		r = &record{}
+		w.servers[tag] = r
+	}
+	kept := r.failures[:0]
+	for _, at := range r.failures {
+		if now.Sub(at) <= w.window {
+			kept = append(kept, at)
+		}
+	}
+	r.failures = append(kept, now)
+	if len(r.failures) < w.threshold || (!r.triggered.IsZero() && now.Sub(r.triggered) < w.cooldown) {
+		return false
+	}
+	r.triggered = now
+	r.failures = r.failures[:0]
+	return true
+}
+
+// Worked notes a dial through the server that went through: the failures before it are no streak.
+func (w *Watch) Worked(tag string) {
+	if w == nil {
+		return
+	}
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	if r := w.servers[tag]; r != nil {
+		r.failures = r.failures[:0]
+	}
+}
diff --git a/common/failwatch/failwatch_test.go b/common/failwatch/failwatch_test.go
new file mode 100644
index 000000000..f361f374c
--- /dev/null
+++ b/common/failwatch/failwatch_test.go
@@ -0,0 +1,53 @@
+package failwatch
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+)
+
+func TestFailedInARow(t *testing.T) {
+	now := time.Now()
+	w := New()
+	w.now = func() time.Time { return now }
+	require.False(t, w.Failed("a"))
+	require.False(t, w.Failed("a"))
+	require.True(t, w.Failed("a"), "the third in a row")
+	// quiet for the cooldown, however many fail
+	for i := 0; i < 5; i++ {
+		require.False(t, w.Failed("a"))
+	}
+	now = now.Add(31 * time.Second)
+	require.False(t, w.Failed("a"))
+	require.False(t, w.Failed("a"))
+	require.True(t, w.Failed("a"))
+}
+
+func TestSuccessBreaksTheStreak(t *testing.T) {
+	w := New()
+	w.Failed("a")
+	w.Failed("a")
+	w.Worked("a")
+	require.False(t, w.Failed("a"))
+	require.False(t, w.Failed("a"))
+	require.True(t, w.Failed("a"))
+	// another server's failures are its own
+	require.False(t, w.Failed("b"))
+}
+
+func TestOldFailuresExpire(t *testing.T) {
+	now := time.Now()
+	w := New()
+	w.now = func() time.Time { return now }
+	w.Failed("a")
+	w.Failed("a")
+	now = now.Add(21 * time.Second)
+	require.False(t, w.Failed("a"), "the first two are too old")
+}
+
+func TestNilWatchIsQuiet(t *testing.T) {
+	var w *Watch
+	require.False(t, w.Failed("a"))
+	w.Worked("a")
+}
diff --git a/common/monitoring/h_ipinfo_refresh.go b/common/monitoring/h_ipinfo_refresh.go
new file mode 100644
index 000000000..b6f8daebf
--- /dev/null
+++ b/common/monitoring/h_ipinfo_refresh.go
@@ -0,0 +1,17 @@
+package monitoring
+
+import "time"
+
+// ipInfoMaxAge is how old an IP/country record from the cache may be before it is fetched again.
+const ipInfoMaxAge = 12 * time.Hour
+
+// H: needIpInfo says whether a server's IP record is to be fetched in this test. It is when there is none; a record
+// kept from an earlier run stays as it is for ipInfoMaxAge. Fetching it again at every start of the core was a
+// TLS handshake through each of the dozens of servers at once (over half of the processor's work in the first
+// minutes after a start), for a record that hardly ever changes.
+func needIpInfo(has, fromCache bool, age time.Duration) bool {
+	if !has {
+		return true
+	}
+	return fromCache && age > ipInfoMaxAge
+}
