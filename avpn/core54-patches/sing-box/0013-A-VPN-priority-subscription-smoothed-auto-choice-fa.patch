+// describe says what the choice between two servers went by: each one's delay as counted (smoothed, with the
+// priority margin), its last results, and whether it is of the priority subscription.
+func (s *LowestDelay) describe(history map[string]*adapter.URLTestHistory, from, to string) string {
+	one := func(tag string) string {
+		text := tag + " " + strconv.Itoa(int(getTagDelay(tag, history))) + " ms"
+		if list := s.samples[tag]; list != nil {
+			text += " " + fmt.Sprint(list.results)
+		}
+		if s.priority[tag] {
+			text += " priority"
+		}
+		return text
+	}
+	return one(from) + " -> " + one(to)
+}
