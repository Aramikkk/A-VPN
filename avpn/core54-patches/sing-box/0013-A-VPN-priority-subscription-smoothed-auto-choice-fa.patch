--- /dev/null
+++ b/common/monitoring/h_ipinfo_refresh_test.go
@@ -0,0 +1,26 @@
+package monitoring
+
+import (
+	"testing"
+	"time"
+)
+
+func TestNeedIpInfo(t *testing.T) {
+	for _, tc := range []struct {
+		name      string
+		has       bool
+		fromCache bool
+		age       time.Duration
+		want      bool
+	}{
+		{"none yet", false, false, 0, true},
+		{"none, from the cache", false, true, time.Minute, true},
+		{"fresh record from the cache is kept", true, true, time.Hour, false},
+		{"old record from the cache is fetched again", true, true, 13 * time.Hour, true},
+		{"record of this run is kept", true, false, 100 * time.Hour, false},
+	} {
+		if got := needIpInfo(tc.has, tc.fromCache, tc.age); got != tc.want {
+			t.Errorf("%s: %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
