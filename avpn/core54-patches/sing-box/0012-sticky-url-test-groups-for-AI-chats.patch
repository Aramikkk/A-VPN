+// urlTestEveryLink tests detour with every link one after the other: the slowest answer is the delay, and a link
+// that fails fails the outbound (a service's own hosts: its page, its API, its media).
+func urlTestEveryLink(ctx context.Context, links []string, detour adapter.Outbound) (uint16, error) {
+	var slowest uint16
+	for _, link := range links {
+		delay, err := urltest.URLTest(ctx, link, detour)
+		if err != nil {
+			return 0, err
+		}
+		if delay > slowest {
+			slowest = delay
+		}
+	}
+	return slowest, nil
+}
+
