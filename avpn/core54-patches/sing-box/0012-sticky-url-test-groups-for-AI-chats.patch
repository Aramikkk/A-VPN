+// stickyDown: a server is down when it has the results of a whole window and none of them answered.
+const stickyExtra = 1000
+
+// H: stickyGivesUp says a sticky group should leave its current server: none of its last tests answered (it needs a
+// whole window of results to say so), or its average is [stickyExtra] ms over the best one's.
+func (g *URLTestGroup) stickyGivesUp(tag string, bestDelay uint32) bool {
+	g.samplesAccess.Lock()
+	list := append([]uint16(nil), g.samples[tag]...)
+	g.samplesAccess.Unlock()
+	if len(list) < g.stableSamples || len(list) == 0 {
+		return false
+	}
+	var sum, answered uint32
+	for _, delay := range list {
+		if delay != 0 && delay != 65535 {
+			sum += uint32(delay)
+			answered++
+		}
+	}
+	if answered == 0 {
+		return true
+	}
+	return answered == uint32(len(list)) && sum/answered > bestDelay+stickyExtra
+}
