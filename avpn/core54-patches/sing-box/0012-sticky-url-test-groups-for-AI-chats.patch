+package group
+
+import "testing"
+
+func TestStickyGivesUp(t *testing.T) {
+	g := &URLTestGroup{stableSamples: 3, samples: map[string][]uint16{}}
+	set := func(results ...uint16) { g.samples["a"] = results }
+
+	set(120, 130)
+	if g.stickyGivesUp("a", 100) {
+		t.Fatal("too few results to judge: it stays")
+	}
+	set(120, 0, 130)
+	if g.stickyGivesUp("a", 100) {
+		t.Fatal("one failed test in three is not enough to leave")
+	}
+	set(0, 65535, 0)
+	if !g.stickyGivesUp("a", 100) {
+		t.Fatal("none of three answered: it leaves")
+	}
+	set(1300, 1400, 1500)
+	if !g.stickyGivesUp("a", 100) {
+		t.Fatal("a second slower than the best: it leaves")
+	}
+	set(400, 450, 500)
+	if g.stickyGivesUp("a", 100) {
+		t.Fatal("slower but not by a second: it stays")
+	}
+	if g.stickyGivesUp("unknown", 100) {
+		t.Fatal("a server with no results stays")
+	}
+}
