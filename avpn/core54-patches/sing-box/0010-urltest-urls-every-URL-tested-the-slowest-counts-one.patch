+	StrictURLs bool `json:"strict_urls,omitempty"`
 	// H: how long one test may take (0: the TCP timeout, 5 s)
 	TestTimeout badoption.Duration `json:"test_timeout,omitempty"`
 }
diff --git a/protocol/group/urltest.go b/protocol/group/urltest.go
index c7fd056f1..114d6dbbd 100644
--- a/protocol/group/urltest.go
+++ b/protocol/group/urltest.go
@@ -52,7 +52,9 @@ type URLTest struct {
 	group                        *URLTestGroup
 	checkAccess                  sync.Mutex
 	interruptExternalConnections bool
-	privateHistory               bool // H
+	privateHistory               bool          // H
+	links                        []string      // H: URLs tested together (the slowest counts)
